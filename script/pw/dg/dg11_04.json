  "jp": "コ……レデ……",
  "en": ""
 },
 {
  "id": "dg11_04:000:02",
  "speaker": "零",
  "jp": "これで……いい……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:03",
  "speaker": "零",
  "jp": "これで……",
  "en": ""
 },
 {
  "id": "dg11_04:000:04",
  "speaker": "零",
  "jp": "すべて、終わる……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:05",
  "speaker": "白",
  "jp": "うむ……\nそうじゃな……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:06",
  "speaker": "白",
  "jp": "思っていたよりも\nずっと―――",
  "en": ""
 },
 {
  "id": "dg11_04:000:07",
  "speaker": "白",
  "jp": "安らかな気分じゃ……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:08",
  "speaker": "白",
  "jp": "全ての札の力がいま―――\n天へと還る……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:09",
  "speaker": "白",
  "jp": "よもや、\nこんな日が来ようとはな……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:10",
  "speaker": "白",
  "jp": "{px}……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:11",
  "speaker": "白",
  "jp": "最後の{ruby:主|あるじ}が其方で、\n本当に……",
  "en": ""
 },
 {
  "id": "dg11_04:000:12",
  "speaker": "白",
  "jp": "―――よかった……。",
  "en": ""
 },
 {
  "id": "dg11_04:000:13",
  "speaker": "零",
  "jp": "{px}、きみと、\nきみの大切な\nひとたちの未来が、",
  "en": ""
 },
 {
  "id": "dg11_04:000:14",
  "speaker": "零",
  "jp": "光と花に、\n満ち溢れていますように―――",
  "en": ""
 },
 {
  "id": "dg11_04:000:15",
  "speaker": "零",
  "jp": "ありがとう、{px}―――",
  "en": ""
 }
]
