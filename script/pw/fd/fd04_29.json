[
 {
  "id": "fd04_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well hello there, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fd04_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "My, my, oh my. Forget to buy somethin'?"
 },
 {
  "id": "fd04_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "ちょっとちょっと、もうもう！\n聞いた？早稲田ちゃん。",
  "en": "Oh, listen, listen, my goodness! Did you hear,\nWaseda-chan?"
 },
 {
  "id": "fd04_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "えらい{ruby:べっぴん|び　じ　ん}さんが\n転校してきたもんやねえ……。",
  "en": "What a stunnin' beauty we got transferrin' in, eh..."
 },
 {
  "id": "fd04_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "昔を思い出すねえ。\nおばちゃんも、昔は誰もが羨む\nないすばでーだったもんさ。",
  "en": "Takes me back. In my day, I had a nice bod-ay\neverybody envied too, y'know."
 },
 {
  "id": "fd04_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "懐かしいねえ、あの頃……。",
  "en": "Those were the days..."
 },
 {
  "id": "fd04_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fd04_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fd04_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "Okay, thank ya, dear. Come agaaain!"
 },
