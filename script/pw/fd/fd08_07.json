[
 {
  "id": "fd08_07:001:00",
  "speaker": "蒐",
  "jp": "…………おう？",
  "en": "......Oh?"
 },
 {
  "id": "fd08_07:001:01",
  "speaker": "蒐",
  "jp": "ね、{px}。\n一つ、聞かせて。",
  "en": "Hey, {px}. Let me ask one thing."
 },
 {
  "id": "fd08_07:001:02",
  "speaker": "蒐",
  "jp": "その格好は、四角っぽい？",
  "en": "That outfit... is it square-ish?"
 },
 {
  "id": "fd08_07:002:00",
  "speaker": "蒐",
  "jp": "……そうなの。",
  "en": "...I see."
 },
 {
  "id": "fd08_07:002:01",
  "speaker": "蒐",
  "jp": "{px}がそう言うなら、\n僕、何も言わない。言えない。",
  "en": "If {px} says so,\nI won't say anything. I can't."
 },
 {
  "id": "fd08_07:003:00",
  "speaker": "蒐",
  "jp": "ふーん。\n……別に構わないけど。",
  "en": "Hmm. ...Not that I mind."
 },
 {
  "id": "fd08_07:004:00",
  "speaker": "蒐",
  "jp": "あ、やっぱり違った。",
  "en": "Ah, it wasn't, after all."
 },
 {
  "id": "fd08_07:005:00",
  "speaker": "蒐",
  "jp": "……そうなの。",
  "en": "...I see."
 },
 {
  "id": "fd08_07:006:00",
  "speaker": "蒐",
  "jp": "あ、今はちょっと四角に\n戻った感じ。",
  "en": "Ah, now it feels a little squarer again."
 },
 {
  "id": "fd08_07:007:00",
  "speaker": "蒐",
  "jp": "だよね、だよね。",
  "en": "Right, right."
 },
 {
  "id": "fd08_07:008:00",
  "speaker": "蒐",
  "jp": "そっか……。\n大変だね。",
  "en": "I see... That's rough."
 },
 {
  "id": "fd08_07:009:00",
  "speaker": "蒐",
  "jp": "難しいよね、四角。",
  "en": "It's hard, isn't it. Squares."
 },
 {
  "id": "fd08_07:010:00",
  "speaker": "蒐",
  "jp": "……四角くないよ、やっぱり。",
  "en": "...It's not square, after all."
 },
 {
  "id": "fd08_07:011:00",
  "speaker": "蒐",
  "jp": "あのね、四角も色々。\nでも、とんがり過ぎると三角に\nなっちゃうよ。",
  "en": "You know, there are all kinds of squares. But\nget too pointy, and you turn into a triangle."
 },
 {
  "id": "fd08_07:011:01",
  "speaker": "蒐",
  "jp": "お気を付けて、かも。",
  "en": "Be careful, maybe."
 },
 {
  "id": "fd08_07:011:02",
  "speaker": "蒐",
  "jp": "僕も人の事言えない、けど。\nくふ、くふふふふ。",
  "en": "Not that I can talk. Kufu, kufufufufu."
 },
 {
  "id": "fd08_07:012:00",
  "speaker": "蒐",
  "jp": "……やっぱり、\nどう見ても三角、かも。",
  "en": "...Yes, any way you look at it, it's a triangle, maybe."
 }
]
