[
 {
  "id": "fd08_07:001:00",
  "speaker": "蒐",
  "jp": "…………おう？",
  "en": ""
 },
 {
  "id": "fd08_07:001:01",
  "speaker": "蒐",
  "jp": "ね、{px}。\n一つ、聞かせて。",
  "en": ""
 },
 {
  "id": "fd08_07:001:02",
  "speaker": "蒐",
  "jp": "その格好は、四角っぽい？",
  "en": ""
 },
 {
  "id": "fd08_07:002:00",
  "speaker": "蒐",
  "jp": "……そうなの。",
  "en": ""
 },
 {
  "id": "fd08_07:002:01",
  "speaker": "蒐",
  "jp": "{px}がそう言うなら、\n僕、何も言わない。言えない。",
  "en": ""
 },
 {
  "id": "fd08_07:003:00",
  "speaker": "蒐",
  "jp": "ふーん。\n……別に構わないけど。",
  "en": ""
 },
 {
  "id": "fd08_07:004:00",
  "speaker": "蒐",
  "jp": "あ、やっぱり違った。",
  "en": ""
 },
 {
  "id": "fd08_07:005:00",
  "speaker": "蒐",
  "jp": "……そうなの。",
  "en": ""
 },
 {
  "id": "fd08_07:006:00",
  "speaker": "蒐",
  "jp": "あ、今はちょっと四角に\n戻った感じ。",
  "en": ""
 },
 {
  "id": "fd08_07:007:00",
  "speaker": "蒐",
  "jp": "だよね、だよね。",
  "en": ""
 },
 {
  "id": "fd08_07:008:00",
  "speaker": "蒐",
  "jp": "そっか……。\n大変だね。",
  "en": ""
 },
 {
  "id": "fd08_07:009:00",
  "speaker": "蒐",
  "jp": "難しいよね、四角。",
  "en": ""
 },
 {
  "id": "fd08_07:010:00",
  "speaker": "蒐",
  "jp": "……四角くないよ、やっぱり。",
  "en": ""
 },
 {
  "id": "fd08_07:011:00",
  "speaker": "蒐",
  "jp": "あのね、四角も色々。\nでも、とんがり過ぎると三角に\nなっちゃうよ。",
  "en": ""
 },
 {
  "id": "fd08_07:011:01",
  "speaker": "蒐",
  "jp": "お気を付けて、かも。",
  "en": ""
 },
 {
  "id": "fd08_07:011:02",
  "speaker": "蒐",
  "jp": "僕も人の事言えない、けど。\nくふ、くふふふふ。",
  "en": ""
 },
 {
  "id": "fd08_07:012:00",
  "speaker": "蒐",
  "jp": "……やっぱり、\nどう見ても三角、かも。",
  "en": ""
 }
]
