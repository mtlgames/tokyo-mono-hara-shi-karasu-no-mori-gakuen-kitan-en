[
 {
  "id": "fd06_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there, dear. Lookin' for somethin'?"
 },
 {
  "id": "fd06_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to buy somethin'?"
 },
 {
  "id": "fd06_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "なんや最近、朝子ちゃん\n元気ないと思わへん？",
  "en": "Don't ya think Asako-chan's been lookin' down\nlately?"
 },
 {
  "id": "fd06_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "朝子ちゃんは真面目やから、\n休むのも下手なんよねえ。\nおばちゃん心配やわ。",
  "en": "Asako-chan's such a serious girl, she's no good at\ntakin' a break, either. It's got me worried."
 },
 {
  "id": "fd06_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "飯田ちゃんの事やし、\n心配いらんと思うけども\nあんまヤンチャしたあかんで？",
  "en": "It's you, Iida-chan, so I don't reckon I need to worry,\nbut don't go causin' too much mischief, ya hear?"
 },
 {
  "id": "fd06_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "やるならバレんようにね。\nはい、あめちゃん。",
  "en": "If ya do, don't get caught. Here, have a candy."
 },
 {
  "id": "fd06_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fd06_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fd06_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thanks, dear. Come again~"
 },
