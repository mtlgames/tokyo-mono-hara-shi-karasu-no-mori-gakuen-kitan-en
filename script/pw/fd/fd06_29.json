[
 {
  "id": "fd06_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": ""
 },
 {
  "id": "fd06_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": ""
 },
 {
  "id": "fd06_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "なんや最近、朝子ちゃん\n元気ないと思わへん？",
  "en": ""
 },
 {
  "id": "fd06_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "朝子ちゃんは真面目やから、\n休むのも下手なんよねえ。\nおばちゃん心配やわ。",
  "en": ""
 },
 {
  "id": "fd06_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "飯田ちゃんの事やし、\n心配いらんと思うけども\nあんまヤンチャしたあかんで？",
  "en": ""
 },
 {
  "id": "fd06_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "やるならバレんようにね。\nはい、あめちゃん。",
  "en": ""
 },
 {
  "id": "fd06_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
