[
 {
  "id": "fd08_17:001:00",
  "speaker": "白",
  "jp": "……ずいぶんと、遊ばれたの。\nひどい有様ではないか。",
  "en": ""
 },
 {
  "id": "fd08_17:001:01",
  "speaker": "白",
  "jp": "脱出に必要な{ruby:措置|そち}とはいえ、\nこれは……",
  "en": ""
 },
 {
  "id": "fd08_17:002:00",
  "speaker": "白",
  "jp": "……執行者たるものが、\nなんと情けない……。",
  "en": ""
 },
 {
  "id": "fd08_17:003:00",
  "speaker": "白",
  "jp": "……{ruby:媚態|しな}を作るな、気色悪い。",
  "en": ""
 },
 {
  "id": "fd08_17:004:00",
  "speaker": "白",
  "jp": "何一つ褒めておらぬぞ。\n……幸せな奴よのう。",
  "en": ""
 },
 {
  "id": "fd08_17:005:00",
  "speaker": "白",
  "jp": "う、うむ……。",
  "en": ""
 },
 {
  "id": "fd08_17:006:00",
  "speaker": "白",
  "jp": "……もう少し、なんとか\nならなかったものかのう……。",
  "en": ""
 },
 {
  "id": "fd08_17:007:00",
  "speaker": "白",
  "jp": "いまは暴言も聞いてやろう。\n……苦労じゃったの。",
  "en": ""
 },
 {
  "id": "fd08_17:008:00",
  "speaker": "白",
  "jp": "かと言って、胸を張る様な\nことでもなかろうが……。",
  "en": ""
 },
 {
  "id": "fd08_17:009:00",
  "speaker": "白",
  "jp": "……苦労じゃったの。",
  "en": ""
 },
 {
  "id": "fd08_17:010:00",
  "speaker": "白",
  "jp": "……もう少し自分を持ったが\n良いと思うぞえ。",
  "en": ""
 },
 {
  "id": "fd08_17:011:00",
  "speaker": "白",
  "jp": "……いまは許してやるわい。",
  "en": ""
 },
 {
  "id": "fd08_17:012:00",
  "speaker": "白",
  "jp": "誇りを取って、\n実利を捨てる愚かさは要らぬ。",
  "en": ""
 },
 {
  "id": "fd08_17:012:01",
  "speaker": "白",
  "jp": "要らぬ、が……。",
  "en": ""
 },
 {
  "id": "fd08_17:012:02",
  "speaker": "白",
  "jp": "……ふう。",
  "en": ""
 },
 {
  "id": "fd08_17:013:00",
  "speaker": "白",
  "jp": "何度もその姿で来るでない！",
  "en": ""
 },
 {
  "id": "fd08_17:013:01",
  "speaker": "白",
  "jp": "……ふう。",
  "en": ""
 }
]
