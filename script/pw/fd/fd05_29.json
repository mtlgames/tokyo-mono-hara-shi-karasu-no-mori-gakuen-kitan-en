[
 {
  "id": "fd05_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well hello, dearie, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fd05_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to buy somethin', did ya?"
 },
 {
  "id": "fd05_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ、神楽ちゃん。\nまた生徒会の子怒らせたやろ。",
  "en": "Oh, Kagura-chan. You went and made that\nstudent council girl mad again, didn't ya?"
 },
 {
  "id": "fd05_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "若い子がお腹空くんは\nしゃあないんやけど、あの子は\nそれがわからへんからね。",
  "en": "Can't be helped that young folks get hungry,\nbut that girl just don't understand that, y'see."
 },
 {
  "id": "fd05_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "あの子、怒るとほんま怖いし\n早弁もほどほどにしときぃや。",
  "en": "She's real scary when she's mad, so go\neasy on the early lunches, ya hear?"
 },
 {
  "id": "fd05_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fd05_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fd05_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thank you, dearie. Come again, now~"
 },
