 {
  "id": "fd05_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ、神楽ちゃん。\nまた生徒会の子怒らせたやろ。",
  "en": ""
 },
 {
  "id": "fd05_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "若い子がお腹空くんは\nしゃあないんやけど、あの子は\nそれがわからへんからね。",
