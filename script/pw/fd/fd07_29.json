[
 {
  "id": "fd07_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there! Lookin' for somethin'?"
 },
 {
  "id": "fd07_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to pick somethin' up?"
 },
 {
  "id": "fd07_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "んふふ、九段ちゃん。\nアンタの噂、よおけ聞くよ。\n人気者やねえ～。",
  "en": "Hehe, Kudan-chan. I hear all kinds\nof talk about you. Ain't you popular~"
 },
 {
  "id": "fd07_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "ま、おばちゃんにしたら\nまだまだ子供やけどね。",
  "en": "Mind you, to Auntie you're still just a kid."
 },
 {
  "id": "fd07_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "はい、あめちゃん。\nアンタこれ好きやろ。",
  "en": "Here, have a candy. You like these, don'tcha?"
 },
 {
  "id": "fd07_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fd07_29:006:00",
  "speaker": "購買のおばちゃん",
