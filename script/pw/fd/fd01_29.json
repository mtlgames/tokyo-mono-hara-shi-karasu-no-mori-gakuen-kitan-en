[
 {
  "id": "fd01_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fd01_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "My, my, my. Forget to buy somethin'?"
 },
 {
  "id": "fd01_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "お兄ちゃん、転校生やろ？\nおばちゃんねえ、生徒の顔は\nみぃんな知ってるからねえ。",
  "en": "You're the transfer student, ain'tcha, hon? Auntie\nhere knows every single student's face, y'know."
 },
 {
  "id": "fd01_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "名前は……えーと、\n中野ちゃんやったね！",
  "en": "Your name's... um... Nakano-chan, right!"
 },
 {
  "id": "fd01_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "なんや学校でいるモンあったら\n遠慮せんと{ruby:購買|うち}に来ぃね。",
  "en": "If ya need anythin' for school, don't be shy, just\ncome on by the shop."
 },
 {
  "id": "fd01_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "せや、とりあえず\nあめちゃん食べ、あめちゃん。",
  "en": "Oh, that's right--here, have a candy, sweetie, go on,\nhave a candy."
 },
 {
  "id": "fd01_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be, hon?"
 },
 {
  "id": "fd01_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be, hon?"
 },
 {
  "id": "fd01_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "Thank ya kindly! Come on back now~!"
 },
