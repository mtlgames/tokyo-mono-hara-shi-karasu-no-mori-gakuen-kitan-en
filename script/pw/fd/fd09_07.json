  "jp": "…………おう？\nおー……。",
  "en": ""
 },
 {
  "id": "fd09_07:001:01",
  "speaker": "蒐",
  "jp": "ね、{px}。\n一つ、聞かせて。",
  "en": ""
 },
 {
  "id": "fd09_07:001:02",
  "speaker": "蒐",
  "jp": "その格好は、四角っぽい？",
  "en": ""
 },
 {
  "id": "fd09_07:002:00",
  "speaker": "蒐",
  "jp": "……そう。",
  "en": ""
 },
 {
  "id": "fd09_07:002:01",
  "speaker": "蒐",
  "jp": "{px}がそう言うなら\n何も、言わない。\n……言えない。",
  "en": ""
 },
 {
  "id": "fd09_07:003:00",
  "speaker": "蒐",
  "jp": "ふうん。\n……そ、か。",
  "en": ""
 },
 {
  "id": "fd09_07:004:00",
  "speaker": "蒐",
  "jp": "あ、やっぱり違った。",
  "en": ""
 },
 {
  "id": "fd09_07:005:00",
  "speaker": "蒐",
  "jp": "……そう。",
  "en": ""
 },
 {
  "id": "fd09_07:006:00",
  "speaker": "蒐",
  "jp": "あ、いまはちょっと\n四角、戻った感じ。",
  "en": ""
 },
 {
  "id": "fd09_07:007:00",
  "speaker": "蒐",
  "jp": "だよね、だよね。",
  "en": ""
 },
 {
  "id": "fd09_07:008:00",
  "speaker": "蒐",
  "jp": "そっか……。\n大変。",
  "en": ""
 },
 {
  "id": "fd09_07:009:00",
  "speaker": "蒐",
  "jp": "難しいよね、四角。",
  "en": ""
 },
 {
  "id": "fd09_07:010:00",
  "speaker": "蒐",
  "jp": "……やっぱり四角くない。",
  "en": ""
 },
 {
  "id": "fd09_07:011:00",
  "speaker": "蒐",
  "jp": "あのね、四角も色々。\nでも、とんがり過ぎると\n三角、になっちゃう。",
  "en": ""
 },
 {
  "id": "fd09_07:011:01",
  "speaker": "蒐",
  "jp": "お気を付けて、かも。",
  "en": ""
 },
 {
  "id": "fd09_07:012:00",
  "speaker": "蒐",
  "jp": "やっぱり、どう見ても\n三角……かも。",
  "en": ""
 },
 {
  "id": "fd09_07:012:01",
  "speaker": "蒐",
  "jp": "二つあれば、いいのかな。",
  "en": ""
 }
