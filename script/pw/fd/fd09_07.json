[
 {
  "id": "fd09_07:001:00",
  "speaker": "蒐",
  "jp": "…………おう？\nおー……。",
  "en": "...Oh? Ohhh..."
 },
 {
  "id": "fd09_07:001:01",
  "speaker": "蒐",
  "jp": "ね、{px}。\n一つ、聞かせて。",
  "en": "Hey, {px}. Let me ask one thing."
 },
 {
  "id": "fd09_07:001:02",
  "speaker": "蒐",
  "jp": "その格好は、四角っぽい？",
  "en": "That outfit... is it square-ish?"
 },
 {
  "id": "fd09_07:002:00",
  "speaker": "蒐",
  "jp": "……そう。",
  "en": "...I see."
 },
 {
  "id": "fd09_07:002:01",
  "speaker": "蒐",
  "jp": "{px}がそう言うなら\n何も、言わない。\n……言えない。",
  "en": "If {px} says so,\nI won't say anything. ...I can't."
 },
 {
  "id": "fd09_07:003:00",
  "speaker": "蒐",
  "jp": "ふうん。\n……そ、か。",
  "en": "Hmm. ...I, see."
 },
 {
  "id": "fd09_07:004:00",
  "speaker": "蒐",
  "jp": "あ、やっぱり違った。",
  "en": "Ah, it wasn't, after all."
 },
 {
  "id": "fd09_07:005:00",
  "speaker": "蒐",
  "jp": "……そう。",
  "en": "...I see."
 },
 {
  "id": "fd09_07:006:00",
  "speaker": "蒐",
  "jp": "あ、いまはちょっと\n四角、戻った感じ。",
  "en": "Ah, just now it felt a little... square again."
 },
 {
  "id": "fd09_07:007:00",
  "speaker": "蒐",
  "jp": "だよね、だよね。",
  "en": "Right, right?"
 },
 {
  "id": "fd09_07:008:00",
  "speaker": "蒐",
  "jp": "そっか……。\n大変。",
  "en": "I see... That's tough."
 },
 {
  "id": "fd09_07:009:00",
  "speaker": "蒐",
  "jp": "難しいよね、四角。",
  "en": "Squares are hard, huh."
 },
 {
  "id": "fd09_07:010:00",
  "speaker": "蒐",
  "jp": "……やっぱり四角くない。",
  "en": "...It's not square, after all."
 },
 {
  "id": "fd09_07:011:00",
  "speaker": "蒐",
  "jp": "あのね、四角も色々。\nでも、とんがり過ぎると\n三角、になっちゃう。",
  "en": "Listen. Squares come in all kinds. But if they\nget too pointy, they turn into... triangles."
 },
 {
  "id": "fd09_07:011:01",
  "speaker": "蒐",
  "jp": "お気を付けて、かも。",
  "en": "Be careful, maybe."
 },
 {
  "id": "fd09_07:012:00",
  "speaker": "蒐",
  "jp": "やっぱり、どう見ても\n三角……かも。",
  "en": "No matter how I look at it, it's a... triangle, maybe."
 },
 {
  "id": "fd09_07:012:01",
  "speaker": "蒐",
  "jp": "二つあれば、いいのかな。",
  "en": "Maybe if there were two, they'd make a square."
 }
]
