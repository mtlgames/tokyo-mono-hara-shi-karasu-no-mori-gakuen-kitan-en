[
 {
  "id": "fd02_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": ""
 },
 {
  "id": "fd02_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": ""
 },
 {
  "id": "fd02_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "なんや怪我してる子が\n増えてるんやて？\nイヤやわ～。",
  "en": ""
 },
 {
  "id": "fd02_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "しかも元気な子ォ揃いの\n剣道部の子ばっかやろ？\n昼が寂しいてかなわんよ。",
  "en": ""
 },
 {
  "id": "fd02_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "落合ちゃんは怪我せんと\nしっかり学校に来ぃや。\nおばちゃんとの約束やで！",
  "en": ""
 },
 {
  "id": "fd02_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "ほら、しっかりあめちゃん\n食べて備えてや。",
  "en": ""
 },
 {
  "id": "fd02_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": ""
 },
 {
