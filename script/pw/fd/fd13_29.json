[
 {
  "id": "fd13_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": ""
 },
 {
  "id": "fd13_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": ""
 },
 {
  "id": "fd13_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、本橋ちゃん。\nもう冬休みの予定は立った？\nおばちゃんなあ……。",
  "en": ""
 },
 {
  "id": "fd13_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "んふふ。\nハワイやで、ハワイ！\nワイハやな。いわゆる所の！",
  "en": ""
 },
 {
  "id": "fd13_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "もういまから楽しみやねん。\n水着も新しいの買ったんよ。\n楽しみやわ～。",
  "en": ""
 },
 {
  "id": "fd13_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "本橋ちゃんにも幸せ、\nお裾分けやで。\nはい、あめちゃん。",
  "en": ""
 },
 {
  "id": "fd13_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": ""
 },
 {
  "id": "fd13_29:006:00",
