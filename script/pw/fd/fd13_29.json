[
 {
  "id": "fd13_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hellooo there, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fd13_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "My, my, my. Forget to buy somethin'?"
 },
 {
  "id": "fd13_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、本橋ちゃん。\nもう冬休みの予定は立った？\nおばちゃんなあ……。",
  "en": "Oh my, Motohashi-chan. Got your winter\nbreak plans sorted yet? 'Cause Auntie here..."
 },
 {
  "id": "fd13_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "んふふ。\nハワイやで、ハワイ！\nワイハやな。いわゆる所の！",
  "en": "Mm-hehe. Hawaii, hon, Hawaii!\n\"Ha-why-ee,\" as the hip folks say!"
 },
 {
  "id": "fd13_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "もういまから楽しみやねん。\n水着も新しいの買ったんよ。\n楽しみやわ～。",
  "en": "I'm already so excited. Even bought\nmyself a brand-new swimsuit. Can't wait!"
 },
 {
  "id": "fd13_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "本橋ちゃんにも幸せ、\nお裾分けやで。\nはい、あめちゃん。",
  "en": "Here's a little of my happiness for you too,\nMotohashi-chan. There ya go, have a candy."
 },
 {
  "id": "fd13_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fd13_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fd13_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "Alright, thank ya kindly. Come again now!"
 },
