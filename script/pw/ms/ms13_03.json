[
 {
  "id": "ms13_03:000:00",
  "speaker": "白",
  "jp": "静かじゃな……。",
  "en": ""
 },
 {
  "id": "ms13_03:000:01",
  "speaker": "白",
  "jp": "何も……聞こえぬ……。",
  "en": ""
 },
 {
  "id": "ms13_03:000:02",
  "speaker": "零",
  "jp": "……そう……かな？",
  "en": ""
 },
 {
  "id": "ms13_03:000:03",
  "speaker": "零",
  "jp": "耳を澄ませてごらん。",
  "en": ""
 },
 {
  "id": "ms13_03:000:04",
  "speaker": "白",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "ms13_03:000:05",
  "speaker": "白",
  "jp": "風……。",
  "en": ""
 },
 {
  "id": "ms13_03:000:06",
  "speaker": "白",
  "jp": "それに……\nあれは―――",
  "en": ""
 },
 {
  "id": "ms13_03:000:07",
  "speaker": "零",
  "jp": "聞こえるだろう？\nおれたちを呼ぶ声が……。",
  "en": ""
 },
 {
  "id": "ms13_03:000:08",
  "speaker": "零",
  "jp": "永劫の闇でも、\n静寂の{ruby:宙|そら}でもない……",
  "en": ""
 },
 {
  "id": "ms13_03:000:09",
  "speaker": "零",
  "jp": "確かな大地の上から、\nあんなにも強く―――",
  "en": ""
 },
 {
  "id": "ms13_03:000:10",
  "speaker": "白",
  "jp": "暖かな、光……\nあそこに妾たちを\n呼ぶ者がおるのか……。",
  "en": ""
 },
 {
  "id": "ms13_03:000:11",
  "speaker": "白",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "ms13_03:000:12",
  "speaker": "白",
  "jp": "妾たちは……\n変わったのだろうか？",
  "en": ""
 },
 {
  "id": "ms13_03:000:13",
  "speaker": "白",
  "jp": "妾たち以外の何者かに？",
  "en": ""
 },
 {
  "id": "ms13_03:000:14",
  "speaker": "零",
  "jp": "変わったかも、知れない。\nだとしても―――",
  "en": ""
 },
 {
  "id": "ms13_03:000:15",
  "speaker": "零",
  "jp": "大切な事はみな、\nこの《心》が知っている。",
  "en": ""
 },
 {
  "id": "ms13_03:000:16",
  "speaker": "白",
  "jp": "そうじゃな……。",
  "en": ""
 },
 {
  "id": "ms13_03:000:17",
  "speaker": "白",
  "jp": "あの光が何なのか、\n妾たちは確かに知っておる。",
  "en": ""
 },
 {
  "id": "ms13_03:000:18",
  "speaker": "白",
  "jp": "あれが―――\n還るべき場所じゃ。",
  "en": ""
 },
 {
  "id": "ms13_03:000:19",
  "speaker": "零",
  "jp": "さあ……戻ろう。",
  "en": ""
 },
 {
  "id": "ms13_03:000:20",
  "speaker": "零",
  "jp": "愛しきひとたちの待つ\nあの場所へ――――――",
  "en": ""
 }
]
