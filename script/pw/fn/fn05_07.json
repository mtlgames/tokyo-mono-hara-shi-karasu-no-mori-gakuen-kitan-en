[
 {
  "id": "fn05_07:001:00",
  "speaker": "蒐",
  "jp": "くふ、くふふ……。\n四角、たくさん……。",
  "en": ""
 },
 {
  "id": "fn05_07:001:01",
  "speaker": "蒐",
  "jp": "新しい四角がね、出たんだよ。\n新しい、キラキラ……。\n新しい四角……。",
  "en": ""
 },
 {
  "id": "fn05_07:001:02",
  "speaker": "蒐",
  "jp": "新しい四角を四角く収納、\n四角く整理。",
  "en": ""
 },
 {
  "id": "fn05_07:001:03",
  "jp": "考えただけでも……。",
  "en": ""
 },
 {
  "id": "fn05_07:001:04",
  "speaker": "蒐",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "fn05_07:001:05",
  "speaker": "蒐",
  "jp": "{px}も、何か……\n新しい、四角持ってる？",
  "en": ""
 },
 {
  "id": "fn05_07:001:06",
  "speaker": "蒐",
  "jp": "違うキラキラ……。\nううん、ぴかぴか……。",
  "en": ""
 },
 {
  "id": "fn05_07:001:07",
  "speaker": "蒐",
  "jp": "見せて、くれる？",
  "en": ""
 },
 {
  "id": "fn05_07:002:00",
  "speaker": "蒐",
  "jp": "おおー……。",
  "en": ""
 },
 {
  "id": "fn05_07:002:01",
  "speaker": "蒐",
  "jp": "……四角い、ね。",
  "en": ""
 },
 {
  "id": "fn05_07:003:00",
  "speaker": "蒐",
  "jp": "そっか……。",
  "en": ""
 },
 {
  "id": "fn05_07:003:01",
  "speaker": "蒐",
  "jp": "でも{px}が持ってる\n四角なら、アレだよね。",
  "en": ""
 },
 {
  "id": "fn05_07:003:02",
  "speaker": "蒐",
  "jp": "―――花札。",
  "en": ""
 },
 {
  "id": "fn05_07:004:00",
  "speaker": "蒐",
  "jp": "その四角、知ってるよ。\n同じの……持ってる。",
  "en": ""
 },
 {
  "id": "fn05_07:004:01",
  "speaker": "蒐",
  "jp": "これ……\n{px}にあげる。",
  "en": ""
 },
 {
  "id": "fn05_07:004:02",
  "speaker": "蒐",
  "jp": "この四角、集まりたがってる。\n集めてる人の所、行くのが\n四角の幸せ……ガマン。",
  "en": ""
 },
 {
  "id": "fn05_07:004:03",
  "speaker": "蒐",
  "jp": "キラキラして、綺麗で、\nすき、だけど……。",
  "en": ""
 },
 {
  "id": "fn05_07:004:04",
  "speaker": "蒐",
  "jp": "でも、{px}だから\n集まりたい。ガマン。",
  "en": ""
 },
 {
  "id": "fn05_07:005:00",
  "speaker": "蒐",
  "jp": "でも、ちょっと心配。\nこの四角……変な感じ。\n集めると不安は更に倍、かも。",
  "en": ""
 },
 {
  "id": "fn05_07:005:01",
  "speaker": "蒐",
  "jp": "……ねえ、\n{px}、大丈夫？",
  "en": ""
 },
 {
  "id": "fn05_07:006:00",
  "speaker": "蒐",
  "jp": "ぼく、何か……\n四角いお手伝い、出来る？",
  "en": ""
 },
 {
  "id": "fn05_07:007:00",
  "speaker": "蒐",
  "jp": "……その言葉、\n正方形に、信じる、よ。",
  "en": ""
 },
 {
  "id": "fn05_07:008:00",
  "speaker": "蒐",
  "jp": "ほんと……？",
  "en": ""
 },
 {
  "id": "fn05_07:008:01",
  "speaker": "蒐",
  "jp": "それなら、嬉しい。\nとっても……すごく……。",
  "en": ""
 },
 {
  "id": "fn05_07:009:00",
  "speaker": "蒐",
  "jp": "ん……。",
  "en": ""
 },
 {
  "id": "fn05_07:009:01",
  "speaker": "蒐",
  "jp": "……うん。",
  "en": ""
 },
 {
  "id": "fn05_07:010:00",
  "speaker": "蒐",
  "jp": "くふふ、よかった。",
  "en": ""
 },
 {
  "id": "fn05_07:011:00",
  "speaker": "蒐",
  "jp": "そっか……。",
  "en": ""
 },
 {
  "id": "fn05_07:012:00",
  "speaker": "蒐",
  "jp": "……そう。",
  "en": ""
 },
 {
  "id": "fn05_07:013:00",
  "speaker": "蒐",
  "jp": "……無理は、言わない。\nそういうの、楕円。",
  "en": ""
 },
 {
  "id": "fn05_07:014:00",
  "speaker": "蒐",
  "jp": "そっか。\n……無理は、言わない。",
  "en": ""
 },
 {
  "id": "fn05_07:015:00",
  "speaker": "蒐",
  "jp": "そっか……。",
  "en": ""
 },
 {
  "id": "fn05_07:016:00",
  "speaker": "蒐",
  "jp": "くふふふ……。",
  "en": ""
 },
 {
  "id": "fn05_07:016:01",
  "speaker": "蒐",
  "jp": "じゃあ……これ。\nお近づきの四角い印。",
  "en": ""
 },
 {
  "id": "fn05_07:016:02",
  "speaker": "蒐",
  "jp": "あと、これもあげる。",
  "en": ""
 },
 {
  "id": "fn05_07:016:03",
  "speaker": "蒐",
  "jp": "色々四角く入れてね。\n四角く、ね。",
  "en": ""
 },
 {
  "id": "fn05_07:016:04",
  "speaker": "蒐",
  "jp": "四角い事なら……任せて。\nくふ、ふふふふ……。",
  "en": ""
 },
 {
  "id": "fn05_07:017:00",
  "speaker": "蒐",
  "jp": "……四角の導きがなければ、\nしょうがない、かも。",
  "en": ""
 },
 {
  "id": "fn05_07:017:01",
  "speaker": "蒐",
  "jp": "寄っていく四角と、\n寄れない四角もある、よね。",
  "en": ""
 },
 {
  "id": "fn05_07:017:02",
  "speaker": "蒐",
  "jp": "しょぼ……。",
  "en": ""
 },
 {
  "id": "fn05_07:018:00",
  "speaker": "蒐",
  "jp": "やっぱり、{px}は\n面白い……。",
  "en": ""
 },
 {
  "id": "fn05_07:018:01",
  "speaker": "蒐",
  "jp": "くふふふ……。",
  "en": ""
 },
 {
  "id": "fn05_07:019:00",
  "speaker": "蒐",
  "jp": "くふふふ……。",
  "en": ""
 },
 {
  "id": "fn05_07:019:01",
  "speaker": "蒐",
  "jp": "キラキラ、ぴかぴか……。",
  "en": ""
 },
 {
  "id": "fn05_07:ksf:0121f",
  "kind": "choice",
  "jp": "見せる",
