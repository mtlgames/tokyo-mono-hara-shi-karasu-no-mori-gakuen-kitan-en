[
 {
  "id": "fn09_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn09_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn09_30:004:00",
  "speaker": "鎧の店員",
  "jp": "ちぃとばかり遠出をして、\nバイト帰りに評判のカレー屋に\n行ったのであるが……。",
  "en": ""
 },
 {
  "id": "fn09_30:004:01",
  "speaker": "鎧の店員",
  "jp": "{ruby:某|それがし}、まだまだでござった。\n袋殿といい、世の中には\n底知れぬ{ruby:武士|もののふ}がおるものよ。",
  "en": ""
 },
 {
  "id": "fn09_30:004:02",
  "speaker": "鎧の店員",
  "jp": "……まあ、あそこまで\n捨てる必要もねぇしなあ……。",
  "en": ""
 },
 {
  "id": "fn09_30:004:03",
  "speaker": "鎧の店員",
  "jp": "俺、バイトだし。",
  "en": ""
 },
 {
  "id": "fn09_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn09_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn09_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
