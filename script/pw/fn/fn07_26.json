[
 {
  "id": "fn07_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": ""
 },
 {
  "id": "fn07_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": ""
 },
 {
  "id": "fn07_26:004:00",
  "speaker": "澁川",
  "jp": "どうやら、厄介な事に\nなっているようだな。",
  "en": ""
 },
 {
  "id": "fn07_26:004:01",
  "speaker": "澁川",
  "jp": "お前に一つ、\n言っておきたい事がある。",
  "en": ""
 },
 {
  "id": "fn07_26:004:02",
  "speaker": "澁川",
  "jp": "{px}、\nお前は……間違えるな。",
  "en": ""
 },
 {
  "id": "fn07_26:005:00",
  "speaker": "澁川",
  "jp": "大事なものがあるならば、\nそれから手を離すんじゃない。",
  "en": ""
 },
 {
  "id": "fn07_26:006:00",
  "speaker": "澁川",
  "jp": "……ふッ。\n言うまでもなかったな。",
  "en": ""
 },
 {
  "id": "fn07_26:007:00",
  "speaker": "澁川",
  "jp": "その笑顔が、曇らない事を\n……祈っている。",
  "en": ""
 },
 {
  "id": "fn07_26:008:00",
  "speaker": "澁川",
  "jp": "……そうだな。",
  "en": ""
 },
 {
  "id": "fn07_26:008:01",
  "speaker": "澁川",
  "jp": "お前は、\n俺とは、違う……。",
  "en": ""
 },
 {
  "id": "fn07_26:009:00",
  "speaker": "澁川",
  "jp": "……ああ。",
  "en": ""
 },
 {
  "id": "fn07_26:010:00",
  "speaker": "澁川",
  "jp": "言われるまでもない、か。",
  "en": ""
 },
 {
  "id": "fn07_26:010:01",
  "speaker": "澁川",
  "jp": "その真っ直ぐさが\nあの頃の俺に……。",
  "en": ""
 },
 {
  "id": "fn07_26:010:02",
  "speaker": "澁川",
  "jp": "いや、忘れてくれ。",
  "en": ""
 },
 {
  "id": "fn07_26:011:00",
  "speaker": "澁川",
  "jp": "お前はそれで、\n本当に後悔しないのか？",
  "en": ""
 },
 {
  "id": "fn07_26:012:00",
  "speaker": "澁川",
  "jp": "悲観に浸っても\n何も、守れない……。",
  "en": ""
 },
 {
  "id": "fn07_26:012:01",
  "speaker": "澁川",
  "jp": "それぐらい、\nわかっているはずだ。",
  "en": ""
 },
 {
  "id": "fn07_26:013:00",
  "speaker": "澁川",
  "jp": "……迷えば、失うぞ。",
  "en": ""
 },
 {
  "id": "fn07_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn07_26:015:00",
  "speaker": "澁川",
  "jp": "手を離さなければ、\n諦めなければ……\n続いた道があった。",
  "en": ""
 },
 {
  "id": "fn07_26:015:01",
  "speaker": "澁川",
  "jp": "なあ、カナエさん……？",
  "en": ""
 },
 {
  "id": "fn07_26:015:02",
  "speaker": "カナエさん",
  "jp": "くぅん……。",
  "en": ""
 },
 {
  "id": "fn07_26:015:03",
  "speaker": "澁川",
  "jp": "{px}、俺のようには……\n間違えるなよ。いいな。",
  "en": ""
 },
 {
  "id": "fn07_26:016:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn07_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn07_26:018:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、来ると良い。",
  "en": ""
 },
