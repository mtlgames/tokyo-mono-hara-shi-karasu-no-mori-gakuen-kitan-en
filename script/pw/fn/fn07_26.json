[
 {
  "id": "fn07_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": "...Glad you came. Business, is it?"
 },
 {
  "id": "fn07_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": "You, huh. ...Do as you like."
 },
 {
  "id": "fn07_26:004:00",
  "speaker": "澁川",
  "jp": "どうやら、厄介な事に\nなっているようだな。",
  "en": "Looks like things have gotten messy."
 },
 {
  "id": "fn07_26:004:01",
  "speaker": "澁川",
  "jp": "お前に一つ、\n言っておきたい事がある。",
  "en": "There's something I want to tell you."
 },
 {
  "id": "fn07_26:004:02",
  "speaker": "澁川",
  "jp": "{px}、\nお前は……間違えるな。",
  "en": "{px}, you...\ndon't make the wrong choice."
 },
 {
  "id": "fn07_26:005:00",
  "speaker": "澁川",
  "jp": "大事なものがあるならば、\nそれから手を離すんじゃない。",
  "en": "If there's something precious\nto you, don't let go of it."
 },
 {
  "id": "fn07_26:006:00",
  "speaker": "澁川",
  "jp": "……ふッ。\n言うまでもなかったな。",
  "en": "...Heh. Didn't need saying, did it."
 },
 {
  "id": "fn07_26:007:00",
  "speaker": "澁川",
  "jp": "その笑顔が、曇らない事を\n……祈っている。",
  "en": "I'm praying... that smile of yours never clouds over."
 },
 {
  "id": "fn07_26:008:00",
  "speaker": "澁川",
  "jp": "……そうだな。",
  "en": "...That's right."
 },
 {
  "id": "fn07_26:008:01",
  "speaker": "澁川",
  "jp": "お前は、\n俺とは、違う……。",
  "en": "You're... not like me..."
 },
 {
  "id": "fn07_26:009:00",
  "speaker": "澁川",
  "jp": "……ああ。",
  "en": "...Yeah."
 },
 {
  "id": "fn07_26:010:00",
  "speaker": "澁川",
  "jp": "言われるまでもない、か。",
  "en": "No need to tell you, huh."
 },
 {
  "id": "fn07_26:010:01",
  "speaker": "澁川",
  "jp": "その真っ直ぐさが\nあの頃の俺に……。",
  "en": "If I'd had that straightforwardness back then..."
 },
 {
  "id": "fn07_26:010:02",
  "speaker": "澁川",
  "jp": "いや、忘れてくれ。",
  "en": "No, forget it."
 },
 {
  "id": "fn07_26:011:00",
  "speaker": "澁川",
  "jp": "お前はそれで、\n本当に後悔しないのか？",
  "en": "Are you really sure you won't regret that?"
 },
 {
  "id": "fn07_26:012:00",
  "speaker": "澁川",
  "jp": "悲観に浸っても\n何も、守れない……。",
  "en": "Wallowing in despair... protects nothing."
 },
 {
  "id": "fn07_26:012:01",
  "speaker": "澁川",
  "jp": "それぐらい、\nわかっているはずだ。",
  "en": "You ought to know that much."
 },
 {
  "id": "fn07_26:013:00",
  "speaker": "澁川",
  "jp": "……迷えば、失うぞ。",
  "en": "...Hesitate, and you'll lose it."
 },
 {
  "id": "fn07_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": "..."
 },
 {
  "id": "fn07_26:015:00",
  "speaker": "澁川",
  "jp": "手を離さなければ、\n諦めなければ……\n続いた道があった。",
  "en": "If I hadn't let go, if I hadn't given\nup... there was a road that went on."
 },
 {
  "id": "fn07_26:015:01",
  "speaker": "澁川",
  "jp": "なあ、カナエさん……？",
  "en": "Isn't that right, Kanae-san...?"
 },
 {
  "id": "fn07_26:015:02",
  "speaker": "カナエさん",
  "jp": "くぅん……。",
  "en": "*Whimper...*"
 },
 {
  "id": "fn07_26:015:03",
  "speaker": "澁川",
  "jp": "{px}、俺のようには……\n間違えるなよ。いいな。",
  "en": "{px}, don't make\nthe same mistake... I did. Got it?"
 },
 {
  "id": "fn07_26:016:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn07_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn07_26:018:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、来ると良い。",
  "en": "...I see. Come again."
 },
