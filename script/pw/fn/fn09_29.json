[
 {
  "id": "fn09_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there! Lookin' for somethin'?"
 },
 {
  "id": "fn09_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to pick somethin' up?"
 },
 {
  "id": "fn09_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あれ、竹橋ちゃんやないの。",
  "en": "Well, if it ain't Takebashi-chan."
 },
 {
  "id": "fn09_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "…………。",
  "en": "..."
 },
 {
  "id": "fn09_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "そうやんねえ。\nそんなはずないやんねえ。",
  "en": "Right, right. That can't be, can it."
 },
 {
  "id": "fn09_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "いややわあ、\n年はとりたくないもんやね。",
  "en": "Oh, dear me. I sure don't wanna get old."
 },
 {
  "id": "fn09_29:004:04",
  "speaker": "購買のおばちゃん",
  "jp": "変な事言うてごめんね。\nはい、あめちゃん。",
  "en": "Sorry for sayin' somethin'\nstrange. Here, have a candy."
 },
 {
  "id": "fn09_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "Well now, what'll it be, then?"
 },
 {
  "id": "fn09_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "Well now, what'll it be, then?"
 },
 {
  "id": "fn09_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "Thanks, hon. Come back soon, ya hear~"
 },
