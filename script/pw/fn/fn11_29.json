[
 {
  "id": "fn11_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well hello, dearie, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fn11_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to buy somethin'?"
 },
 {
  "id": "fn11_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "クリスマスは息子が家に\n帰ってくるんよ。",
  "en": "My son's comin' home for Christmas, y'know."
 },
 {
  "id": "fn11_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "夕飯、何作ったろうかなあ。\nハンバーグの美味しいのんに\nしようかなあ……。",
  "en": "What should I make him for dinner?\nMaybe a real tasty hamburg steak..."
 },
 {
  "id": "fn11_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "んふふ……。",
  "en": "Mm-hm-hm..."
 },
 {
  "id": "fn11_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fn11_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fn11_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thank you, dearie. Come again, now~"
 },
