[
 {
  "id": "fn03_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn03_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn03_30:004:00",
  "speaker": "鎧の店員",
  "jp": "萌えと燃え……。\n二つは似て非なるもの。",
  "en": ""
 },
 {
  "id": "fn03_30:004:01",
  "speaker": "鎧の店員",
  "jp": "いくら売り上げのためとはいえ\nメイドやネコミミなど邪道！",
  "en": ""
 },
 {
  "id": "fn03_30:004:02",
  "speaker": "鎧の店員",
  "jp": "そこを店長と意気投合して、\nこの格好と相成ったが……。",
  "en": ""
 },
 {
  "id": "fn03_30:004:03",
  "speaker": "鎧の店員",
  "jp": "なんかミスったな～。\n趣味と実益っちゃあ、\nそうなんだけどさ～。",
  "en": ""
 },
 {
  "id": "fn03_30:004:04",
  "speaker": "鎧の店員",
  "jp": "あー……\n重っ。",
  "en": ""
 },
 {
  "id": "fn03_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn03_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn03_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
