[
 {
  "id": "fn09_16:001:00",
  "speaker": "紅緒",
  "jp": "あ……！\nあの、よければ\n手伝ってもらえませんか？",
  "en": ""
 },
 {
  "id": "fn09_16:001:01",
  "speaker": "紅緒",
  "jp": "{ruby:月舟|このこ}が……。",
  "en": ""
 },
 {
  "id": "fn09_16:001:02",
  "speaker": "紅緒",
  "jp": "小さい棘か何か、踏んで\nしまったみたいなんです。",
  "en": ""
 },
 {
  "id": "fn09_16:001:03",
  "speaker": "紅緒",
  "jp": "動くと痛むのに、\nお医者さまに連れて行こうと\nすると、暴れてしまって……。",
  "en": ""
 },
 {
  "id": "fn09_16:001:04",
  "speaker": "紅緒",
  "jp": "なんとか抜いてあげたいのに\n失敗ばかりで、余計痛がって\nしまうんです。",
  "en": ""
 },
 {
  "id": "fn09_16:001:05",
  "speaker": "紅緒",
  "jp": "私、どうすれば……。",
  "en": ""
 },
 {
  "id": "fn09_16:002:00",
  "speaker": "紅緒",
  "jp": "私……\nどうすれば……。",
  "en": ""
 },
 {
  "id": "fn09_16:002:01",
  "speaker": "紅緒",
  "jp": "月舟に刺さった棘は小さすぎて\n指では上手く抜けないんです。",
  "en": ""
 },
 {
  "id": "fn09_16:002:02",
  "speaker": "紅緒",
  "jp": "暴れたせいか、\n奥に食い込んでしまって……。",
  "en": ""
 },
 {
  "id": "fn09_16:004:00",
  "speaker": "紅緒",
  "jp": "これは……。",
  "en": ""
 },
 {
  "id": "fn09_16:004:01",
  "speaker": "紅緒",
  "jp": "月舟、これなら痛くない。\n大丈夫。",
  "en": ""
 },
 {
  "id": "fn09_16:004:02",
  "speaker": "紅緒",
  "jp": "あっ……。",
  "en": ""
 },
 {
  "id": "fn09_16:004:03",
  "speaker": "紅緒",
  "jp": "……よかった。",
  "en": ""
 },
 {
  "id": "fn09_16:004:04",
  "speaker": "月舟",
  "jp": "……きゅい！",
  "en": ""
 },
 {
  "id": "fn09_16:004:05",
  "speaker": "紅緒",
  "jp": "うん。\n……そう、そうね月舟。",
  "en": ""
 },
 {
  "id": "fn09_16:004:06",
  "speaker": "紅緒",
  "jp": "{px}、これを……。",
  "en": ""
 },
 {
  "id": "fn09_16:004:07",
  "speaker": "紅緒",
  "jp": "{ruby:月舟|このこ}からの、お礼です。\n……ね？月舟。",
  "en": ""
 },
 {
  "id": "fn09_16:004:08",
  "speaker": "月舟",
  "jp": "きゅ！",
  "en": ""
 },
 {
  "id": "fn09_16:005:00",
  "speaker": "紅緒",
  "jp": "……これで？",
  "en": ""
 },
 {
  "id": "fn09_16:005:01",
  "speaker": "紅緒",
  "jp": "あっ……。\n月舟、大丈夫？",
  "en": ""
 },
 {
  "id": "fn09_16:005:02",
  "speaker": "紅緒",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn09_16:005:03",
  "speaker": "紅緒",
  "jp": "……なんとか、お医者さまに\n連れて行ってみます。",
  "en": ""
 },
 {
  "id": "fn09_16:005:04",
  "speaker": "紅緒",
  "jp": "あの……\nお手間をとらせました。\nすみません。",
  "en": ""
 },
 {
  "id": "fn09_16:006:00",
  "speaker": "紅緒",
  "jp": "月舟……。",
  "en": ""
 },
 {
  "id": "fn09_16:006:01",
  "speaker": "紅緒",
  "jp": "言う事を……きいて。",
  "en": ""
 },
 {
  "id": "fn09_16:008:00",
  "speaker": "紅緒",
  "jp": "……ほんとうに、\nありがとうございました。",
  "en": ""
 },
 {
  "id": "fn09_16:009:00",
  "speaker": "紅緒",
  "jp": "これだけ暴れたのだから、\nそのうち\n眠ってしまうでしょう。",
  "en": ""
 },
 {
  "id": "fn09_16:009:01",
  "speaker": "紅緒",
  "jp": "その間に……なんとか\n病院に連れて行ってみます。\n怒るかもしれませんが……。",
  "en": ""
 },
 {
  "id": "fn09_16:009:02",
  "speaker": "紅緒",
  "jp": "……お手間を取らせました。\nすみません。",
  "en": ""
 },
