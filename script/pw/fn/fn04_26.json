[
 {
  "id": "fn04_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": ""
 },
 {
  "id": "fn04_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": ""
 },
 {
  "id": "fn04_26:004:00",
  "speaker": "澁川",
  "jp": "……今日は、出会いが重なる。\nそういう流れの日かも\nしれんな。",
  "en": ""
 },
 {
  "id": "fn04_26:004:01",
  "speaker": "澁川",
  "jp": "交差しては、離れ……\nまたいつか何処かで交わる。",
  "en": ""
 },
 {
  "id": "fn04_26:005:00",
  "speaker": "澁川",
  "jp": "出会いと別れ……\n縁はまるで、川のようだ。\nそうは、思わないか？",
  "en": ""
 },
 {
  "id": "fn04_26:006:00",
  "speaker": "澁川",
  "jp": "そうやって、繋がって\nいくんだな……。",
  "en": ""
 },
 {
  "id": "fn04_26:006:01",
  "speaker": "澁川",
  "jp": "{px}、お前は、\n大きな川になりそうだ。",
  "en": ""
 },
 {
  "id": "fn04_26:007:00",
  "speaker": "澁川",
  "jp": "ふッ……。\n邪気のない目だ。",
  "en": ""
 },
 {
  "id": "fn04_26:007:01",
  "speaker": "澁川",
  "jp": "そういう川にこそ\n沿いたい流れも……多くある。",
  "en": ""
 },
 {
  "id": "fn04_26:008:00",
  "speaker": "澁川",
  "jp": "どんな流れも、\n巻き込んでしまいそうな\n勢いだな……。",
  "en": ""
 },
 {
  "id": "fn04_26:009:00",
  "speaker": "澁川",
  "jp": "ああ……本当に。",
  "en": ""
 },
 {
  "id": "fn04_26:010:00",
  "speaker": "澁川",
  "jp": "……長く生きれば、\nお前にもわかる日が来る。",
  "en": ""
 },
 {
  "id": "fn04_26:011:00",
  "speaker": "澁川",
  "jp": "変わらずに、交わらずに……。",
  "en": ""
 },
 {
  "id": "fn04_26:011:01",
  "speaker": "澁川",
  "jp": "そんな川も、ある。",
  "en": ""
 },
 {
  "id": "fn04_26:012:00",
  "speaker": "澁川",
  "jp": "悲観するような話じゃ、ない。",
  "en": ""
 },
 {
  "id": "fn04_26:013:00",
  "speaker": "澁川",
  "jp": "……まだ、実感は\n出来ないかもしれんな。",
  "en": ""
 },
 {
  "id": "fn04_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn04_26:015:00",
  "speaker": "澁川",
  "jp": "一度交わった流れは\n例え離れても、再び\n巡り会う時がくるだろう。",
  "en": ""
 },
 {
  "id": "fn04_26:015:01",
  "speaker": "澁川",
  "jp": "何か、{ruby:導|しるべ}があれば\nより容易くなるかもしれん。\n……ここが―――",
  "en": ""
 },
 {
  "id": "fn04_26:015:02",
  "speaker": "澁川",
  "jp": "……少し、喋りすぎたな。",
  "en": ""
 },
 {
  "id": "fn04_26:016:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn04_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn04_26:018:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、来るといい。",
  "en": ""
 },
