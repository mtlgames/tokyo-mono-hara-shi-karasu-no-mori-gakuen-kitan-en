[
 {
  "id": "fn06_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there, hon! What can I get ya?"
 },
 {
  "id": "fn06_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to buy somethin'?"
 },
 {
  "id": "fn06_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "なんや、寒うなってきたね。\nこんな日は早く整理して、\n家に早く帰りたいわあ。",
  "en": "My, it's gettin' cold, ain't it. On days like this\nI wanna tidy up quick and hurry on home."
 },
 {
  "id": "fn06_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "あっ、別に早う帰れとか\n言うてる訳ちゃうよ！\n勘違いせんといてね？",
  "en": "Oh, I ain't tellin' you to hurry off home or\nnothin'! Don't get the wrong idea, okay?"
 },
 {
  "id": "fn06_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn06_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn06_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thank you kindly. Come on back now!"
 },
