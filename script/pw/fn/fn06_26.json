[
 {
  "id": "fn06_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": "...Welcome. Here on business?"
 },
 {
  "id": "fn06_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": "You. ...Make yourself at home."
 },
 {
  "id": "fn06_26:003:00",
  "speaker": "澁川",
  "jp": "……ひょっとして、\n頼んだものの件か？",
  "en": "...Is this, by chance, about what I asked for?"
 },
 {
  "id": "fn06_26:005:00",
  "speaker": "澁川",
  "jp": "む……？\n俺とした事が、\n計算を誤ったか……。",
  "en": "Hm...? Did I, of all people, miscalculate...?"
 },
 {
  "id": "fn06_26:005:01",
  "speaker": "澁川",
  "jp": "おかしい……。\nまだなくなるはずでは\nなかったが……。",
  "en": "Strange... It shouldn't have run out yet..."
 },
 {
  "id": "fn06_26:005:02",
  "speaker": "澁川",
  "jp": "……{px}。\n甘味料を持っていないか？",
  "en": "...{px}. Do you\nhave any sweetener on you?"
 },
 {
  "id": "fn06_26:007:00",
  "speaker": "澁川",
  "jp": "……ありがたい。",
  "en": "...Much appreciated."
 },
 {
  "id": "fn06_26:007:01",
  "speaker": "澁川",
  "jp": "……そうだな。\nこれを。",
  "en": "...Let's see. Take this."
 },
 {
  "id": "fn06_26:007:02",
  "speaker": "澁川",
  "jp": "大した物じゃないが……\n使ってくれ。",
  "en": "It's nothing much... but put it to use."
 },
 {
  "id": "fn06_26:008:00",
  "speaker": "澁川",
  "jp": "……急には無理か。\nそれはそうだな。",
  "en": "...Can't do it on short notice. Fair enough."
 },
 {
  "id": "fn06_26:009:00",
  "speaker": "澁川",
  "jp": "しかし在庫管理は完璧のはず。\n今日の注文で何か……。",
  "en": "But my stock management should be\nperfect. Something in today's orders..."
 },
 {
  "id": "fn06_26:009:01",
  "speaker": "澁川",
  "jp": "……あ。",
  "en": "...Ah."
 },
 {
  "id": "fn06_26:009:02",
  "speaker": "澁川",
  "jp": "…………。",
  "en": "..."
 },
 {
  "id": "fn06_26:009:03",
  "speaker": "澁川",
  "jp": "伊佐地相手で、助かった。\n……気をつけるとしよう。",
  "en": "Lucky it was only Isachi. ...I'll be more careful."
 },
 {
  "id": "fn06_26:010:00",
  "speaker": "澁川",
  "jp": "……そうか。",
  "en": "...I see."
 },
 {
  "id": "fn06_26:011:00",
  "speaker": "澁川",
  "jp": "甘味料なんだが……\nもし持っていたら\n譲ってもらえないか。",
  "en": "About that sweetener... If you have\nany, could you spare me some?"
 },
 {
  "id": "fn06_26:013:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn06_26:014:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn06_26:015:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn06_26:016:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、来るといい。",
  "en": "...I see. Come again."
 },
