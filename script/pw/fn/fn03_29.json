 {
  "id": "fn03_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": ""
 },
 {
  "id": "fn03_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": ""
 },
 {
  "id": "fn03_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あら、馬場ちゃんやないの。\nちょっと聞いた？",
  "en": ""
 },
 {
  "id": "fn03_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "これはおばちゃんの友達の\nお姉ちゃんのお姑さんが\nほんまに見た話やねんけど、",
  "en": ""
 },
 {
  "id": "fn03_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "最近、ヒーローがおるねんて！\nヒーローて、またえらいんが\n出てきたもんやで～。",
  "en": ""
 },
 {
  "id": "fn03_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "えーと……とーきょー\nべーえむだぶりゅー？\nなんや、速そうやんねえ。",
  "en": ""
 },
 {
  "id": "fn03_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": ""
 },
 {
