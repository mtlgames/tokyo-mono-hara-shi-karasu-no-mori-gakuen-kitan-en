[
 {
  "id": "fn03_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hellooo there, dearie. Lookin' for somethin'?"
 },
 {
  "id": "fn03_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to pick somethin' up?"
 },
 {
  "id": "fn03_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あら、馬場ちゃんやないの。\nちょっと聞いた？",
  "en": "Oh, if it ain't Baba-chan. Did you hear?"
 },
 {
  "id": "fn03_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "これはおばちゃんの友達の\nお姉ちゃんのお姑さんが\nほんまに見た話やねんけど、",
  "en": "Now, this is somethin' my friend's sister's\nmother-in-law really saw with her own eyes,"
 },
 {
  "id": "fn03_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "最近、ヒーローがおるねんて！\nヒーローて、またえらいんが\n出てきたもんやで～。",
  "en": "but there's a hero goin' around lately! A hero,\ncan you believe it? What a thing to turn up~."
 },
 {
  "id": "fn03_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "えーと……とーきょー\nべーえむだぶりゅー？\nなんや、速そうやんねえ。",
  "en": "Let's see... Tokyo... Bee-Em-Double-You?\nSounds fast, don't it?"
 },
 {
  "id": "fn03_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn03_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn03_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thanks, dearie. Come back now~."
 },
