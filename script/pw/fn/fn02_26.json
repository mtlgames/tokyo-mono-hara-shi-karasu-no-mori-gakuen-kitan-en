[
 {
  "id": "fn02_26:001:00",
  "speaker": "隻眼の老人",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": "...Welcome. Here on... business?"
 },
 {
  "id": "fn02_26:002:00",
  "speaker": "隻眼の老人",
  "jp": "お前か。\n……好きにしていけ。",
  "en": "You, is it. ...Do as you like."
 },
 {
  "id": "fn02_26:003:00",
  "speaker": "隻眼の老人",
  "jp": "……話、か。\nそうだな……。",
  "en": "...Talk, is it. Let me see..."
 },
 {
  "id": "fn02_26:003:01",
  "speaker": "隻眼の老人",
  "jp": "動物には、人間と同じ物を\n食べさせてはいけない。",
  "en": "Animals mustn't be fed the same things people eat."
 },
 {
  "id": "fn02_26:003:02",
  "speaker": "隻眼の老人",
  "jp": "人に適量である塩分や糖分も\n{ruby:動物|あいつら}の身体には過剰となる。",
  "en": "The salt and sugar that are just right\nfor people are too much for their bodies."
 },
 {
  "id": "fn02_26:003:03",
  "speaker": "隻眼の老人",
  "jp": "……約束、出来るか。",
  "en": "...Can you promise me?"
 },
 {
  "id": "fn02_26:004:00",
  "speaker": "隻眼の老人",
  "jp": "決して動物に人間の食い物を\nやらない、と。",
  "en": "That you will never give animals human food."
 },
 {
  "id": "fn02_26:005:00",
  "speaker": "隻眼の老人",
  "jp": "……ふっ。\n若いのに、\nわかっている様だな。",
  "en": "...Heh. Young as you are, you seem to understand."
 },
 {
  "id": "fn02_26:006:00",
  "speaker": "隻眼の老人",
  "jp": "……ふっ。",
  "en": "...Heh."
 },
 {
  "id": "fn02_26:007:00",
  "speaker": "隻眼の老人",
  "jp": "……約束するだけで、構わん。",
  "en": "...Just promising is enough."
 },
 {
  "id": "fn02_26:008:00",
  "speaker": "隻眼の老人",
  "jp": "……ああ。",
  "en": "...Yes."
 },
 {
  "id": "fn02_26:009:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": "......"
 },
 {
  "id": "fn02_26:010:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": "......"
 },
 {
  "id": "fn02_26:011:00",
  "speaker": "隻眼の老人",
  "jp": "……そうだな。\n確かに、寂しいものだ。",
  "en": "...I suppose so. It is lonely, indeed."
 },
 {
  "id": "fn02_26:012:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": "......"
 },
 {
  "id": "fn02_26:013:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": "......"
 },
 {
  "id": "fn02_26:014:00",
  "speaker": "隻眼の老人",
  "jp": "気をつける事だ。\n求める物すべてに応えるのは、\n愛じゃない。",
  "en": "Be careful. Giving them\neverything they ask for isn't love."
 },
 {
  "id": "fn02_26:014:01",
  "speaker": "隻眼の老人",
  "jp": "……頼む。",
  "en": "...I'm counting on you."
 },
 {
  "id": "fn02_26:015:00",
  "speaker": "隻眼の老人",
  "jp": "何か……他に、あるか？",
  "en": "Is there... anything else?"
 },
 {
  "id": "fn02_26:016:00",
  "speaker": "隻眼の老人",
  "jp": "何か……他に、あるか？",
  "en": "Is there... anything else?"
 },
 {
  "id": "fn02_26:018:00",
  "speaker": "隻眼の老人",
  "jp": "……そうか。\nまた、来るといい。",
  "en": "...I see. Come again."
 },
