[
 {
  "id": "fn02_26:001:00",
  "speaker": "隻眼の老人",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": ""
 },
 {
  "id": "fn02_26:002:00",
  "speaker": "隻眼の老人",
  "jp": "お前か。\n……好きにしていけ。",
  "en": ""
 },
 {
  "id": "fn02_26:003:00",
  "speaker": "隻眼の老人",
  "jp": "……話、か。\nそうだな……。",
  "en": ""
 },
 {
  "id": "fn02_26:003:01",
  "speaker": "隻眼の老人",
  "jp": "動物には、人間と同じ物を\n食べさせてはいけない。",
  "en": ""
 },
 {
  "id": "fn02_26:003:02",
  "speaker": "隻眼の老人",
  "jp": "人に適量である塩分や糖分も\n{ruby:動物|あいつら}の身体には過剰となる。",
  "en": ""
 },
 {
  "id": "fn02_26:003:03",
  "speaker": "隻眼の老人",
  "jp": "……約束、出来るか。",
  "en": ""
 },
 {
  "id": "fn02_26:004:00",
  "speaker": "隻眼の老人",
  "jp": "決して動物に人間の食い物を\nやらない、と。",
  "en": ""
 },
 {
  "id": "fn02_26:005:00",
  "speaker": "隻眼の老人",
  "jp": "……ふっ。\n若いのに、\nわかっている様だな。",
  "en": ""
 },
 {
  "id": "fn02_26:006:00",
  "speaker": "隻眼の老人",
  "jp": "……ふっ。",
  "en": ""
 },
 {
  "id": "fn02_26:007:00",
  "speaker": "隻眼の老人",
  "jp": "……約束するだけで、構わん。",
  "en": ""
 },
 {
  "id": "fn02_26:008:00",
  "speaker": "隻眼の老人",
  "jp": "……ああ。",
  "en": ""
 },
 {
  "id": "fn02_26:009:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn02_26:010:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn02_26:011:00",
  "speaker": "隻眼の老人",
  "jp": "……そうだな。\n確かに、寂しいものだ。",
  "en": ""
 },
 {
  "id": "fn02_26:012:00",
  "speaker": "隻眼の老人",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn02_26:013:00",
