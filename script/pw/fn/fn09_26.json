[
 {
  "id": "fn09_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": ""
 },
 {
  "id": "fn09_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": ""
 },
 {
  "id": "fn09_26:004:00",
  "speaker": "澁川",
  "jp": "お前が無事でよかった。\n俺の方も、見ての通りだ。",
  "en": ""
 },
 {
  "id": "fn09_26:004:01",
  "speaker": "澁川",
  "jp": "昔を、思い出した……\nたまには、悪くない。",
  "en": ""
 },
 {
  "id": "fn09_26:004:02",
  "speaker": "澁川",
  "jp": "それにしても{px}、\nお前の仕事ぶりを\n間近で見て思ったが……",
  "en": ""
 },
 {
  "id": "fn09_26:005:00",
  "speaker": "澁川",
  "jp": "やはり、筋がいいな。",
  "en": ""
 },
 {
  "id": "fn09_26:006:00",
  "speaker": "澁川",
  "jp": "まったく、\n……お前という奴は。",
  "en": ""
 },
 {
  "id": "fn09_26:006:01",
  "speaker": "澁川",
  "jp": "だが……悪くはない。",
  "en": ""
 },
 {
  "id": "fn09_26:007:00",
  "speaker": "澁川",
  "jp": "ふッ……。\n大した自信だ。",
  "en": ""
 },
 {
  "id": "fn09_26:008:00",
  "speaker": "澁川",
  "jp": "ふッ……。\nだが、精進する部分は\nまだまだある、だろう？",
  "en": ""
 },
 {
  "id": "fn09_26:009:00",
  "speaker": "澁川",
  "jp": "ああ。\n……大したものだ。",
  "en": ""
 },
 {
  "id": "fn09_26:010:00",
  "speaker": "澁川",
  "jp": "理想が高いのは、\n悪い事じゃない。",
  "en": ""
 },
 {
  "id": "fn09_26:010:01",
  "speaker": "澁川",
  "jp": "納得いくように\nこれからも精進すればいい。",
  "en": ""
 },
 {
  "id": "fn09_26:011:00",
  "speaker": "澁川",
  "jp": "ふッ……。\n気に障ったなら、謝ろう。",
  "en": ""
 },
 {
  "id": "fn09_26:012:00",
  "speaker": "澁川",
  "jp": "……卑下するな。",
  "en": ""
 },
 {
  "id": "fn09_26:012:01",
  "speaker": "澁川",
  "jp": "過大評価は勿論駄目だが、\n過小評価するのも\n自分のためには、ならん。",
  "en": ""
 },
 {
  "id": "fn09_26:013:00",
  "speaker": "澁川",
  "jp": "{px}、\n……胸を張れ。",
  "en": ""
 },
 {
  "id": "fn09_26:013:01",
  "speaker": "澁川",
  "jp": "過大評価は勿論駄目だが、\n過小評価するのも\n自分のためには、ならん。",
  "en": ""
 },
 {
  "id": "fn09_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn09_26:015:00",
  "speaker": "澁川",
  "jp": "そうだな……。\n手を出せ。",
  "en": ""
 },
 {
  "id": "fn09_26:015:01",
  "speaker": "澁川",
  "jp": "うちの店の……特製だ。\nとっておけ。",
  "en": ""
 },
 {
  "id": "fn09_26:015:02",
  "speaker": "澁川",
  "jp": "凄腕の請負人に巡り会えた\n俺の運もまだまだ、\n捨てたものではなかったな。",
  "en": ""
 },
 {
  "id": "fn09_26:016:00",
  "speaker": "澁川",
  "jp": "……やはり、\n時代はお前達のものだ。",
  "en": ""
 },
 {
  "id": "fn09_26:016:01",
  "speaker": "澁川",
  "jp": "俺は……ただの喫茶店の{ruby:親父|マスター}。\nそれがいい。",
  "en": ""
 },
 {
  "id": "fn09_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn09_26:018:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn09_26:019:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、来るといい。",
  "en": ""
 },
