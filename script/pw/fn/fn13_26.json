[
 {
  "id": "fn13_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": "...Good of you to come. Work?"
 },
 {
  "id": "fn13_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": "You again. ...Make yourself at home."
 },
 {
  "id": "fn13_26:004:00",
  "speaker": "澁川",
  "jp": "ゆっくりして行け。\nどうせ、客はいない。",
  "en": "Take your time. There aren't any customers anyway."
 },
 {
  "id": "fn13_26:004:01",
  "speaker": "澁川",
  "jp": "…………。",
  "en": "..."
 },
 {
  "id": "fn13_26:004:02",
  "speaker": "澁川",
  "jp": "最近……\nどうも客層が、変わった。",
  "en": "Lately... the clientele's changed, somehow."
 },
 {
  "id": "fn13_26:004:03",
  "speaker": "澁川",
  "jp": "この店を構えて、五年。\n……待つための場所だった。",
  "en": "Five years since I opened this place. ...It was a place\nfor waiting."
 },
 {
  "id": "fn13_26:004:04",
  "speaker": "澁川",
  "jp": "だが、出会うための\n場所という姿も、\n持ち始めている……。",
  "en": "But it's starting to become a place for meeting\npeople, too..."
 },
 {
  "id": "fn13_26:005:00",
  "speaker": "澁川",
  "jp": "{px}。\n……お前が来てから、だな。",
  "en": "{px}. ...Ever since you showed up."
 },
 {
  "id": "fn13_26:006:00",
  "speaker": "澁川",
  "jp": "ああ。\n俺は……この変化を\n嬉しく感じている。",
  "en": "Yeah. I'm... glad about this change."
 },
 {
  "id": "fn13_26:007:00",
  "speaker": "澁川",
  "jp": "……ふッ。",
  "en": "...Heh."
 },
 {
  "id": "fn13_26:007:01",
  "speaker": "澁川",
  "jp": "そうだ。\n……悪くない、変化だ。",
  "en": "That's right. ...It's not a bad change."
 },
 {
  "id": "fn13_26:008:00",
  "speaker": "澁川",
  "jp": "ああ。",
  "en": "Yeah."
 },
 {
  "id": "fn13_26:008:01",
  "speaker": "澁川",
  "jp": "俺も少しは……\nお前のそういう所を\n見習った方がいいな。",
  "en": "Maybe I ought to... learn a little from that side of\nyou."
 },
 {
  "id": "fn13_26:009:00",
  "speaker": "澁川",
  "jp": "……ああ。",
  "en": "...Yeah."
 },
 {
  "id": "fn13_26:010:00",
  "speaker": "澁川",
  "jp": "……自覚がないか？",
  "en": "...You don't realize it?"
 },
 {
  "id": "fn13_26:011:00",
  "speaker": "澁川",
  "jp": "やれやれ、\n自覚無し……か。",
  "en": "Good grief. Doesn't even realize it..."
 },
 {
  "id": "fn13_26:012:00",
  "speaker": "澁川",
  "jp": "……勘違いするな。\n悪いといっている訳じゃない。",
  "en": "...Don't get the wrong idea. I'm not saying it's a bad\nthing."
 },
 {
  "id": "fn13_26:012:01",
  "speaker": "澁川",
  "jp": "俺はむしろ……\n嬉しく思っている。",
  "en": "If anything... I'm glad."
 },
 {
  "id": "fn13_26:013:00",
  "speaker": "澁川",
  "jp": "自覚がないか？",
  "en": "You don't realize it?"
 },
 {
  "id": "fn13_26:013:01",
  "speaker": "澁川",
  "jp": "……勘違いするな。\n悪いといっている訳じゃない。",
  "en": "...Don't get the wrong idea. I'm not saying it's a bad\nthing."
 },
 {
  "id": "fn13_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": "..."
 },
 {
  "id": "fn13_26:015:00",
  "speaker": "澁川",
  "jp": "お前とお前に繋がる縁が\nその手を離れたところまでにも\n影響を与えた。",
  "en": "You and the ties connected to you have left their\nmark even far beyond your reach."
 },
 {
  "id": "fn13_26:015:01",
  "speaker": "澁川",
  "jp": "人、人……\n全く、面白い。",
  "en": "People, people... Truly interesting."
 },
 {
  "id": "fn13_26:015:02",
  "speaker": "澁川",
  "jp": "それを思い出させてくれた\nお前には、本当に\n感謝している。",
  "en": "I'm grateful to you, really, for reminding me of that."
 },
 {
  "id": "fn13_26:015:03",
  "speaker": "澁川",
  "jp": "……なあ、カナエさん？",
  "en": "...Right, Kanae-san?"
 },
 {
  "id": "fn13_26:015:04",
  "speaker": "カナエ",
  "jp": "わふッ！！",
  "en": "*Woof!!*"
 },
 {
  "id": "fn13_26:016:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn13_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": "Anything... else?"
 },
 {
  "id": "fn13_26:018:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、いつでも来い。",
  "en": "...I see. Come by again anytime."
 },
