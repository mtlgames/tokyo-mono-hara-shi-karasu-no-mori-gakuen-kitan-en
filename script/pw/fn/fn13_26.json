[
 {
  "id": "fn13_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": ""
 },
 {
  "id": "fn13_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": ""
 },
 {
  "id": "fn13_26:004:00",
  "speaker": "澁川",
  "jp": "ゆっくりして行け。\nどうせ、客はいない。",
  "en": ""
 },
 {
  "id": "fn13_26:004:01",
  "speaker": "澁川",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn13_26:004:02",
  "speaker": "澁川",
  "jp": "最近……\nどうも客層が、変わった。",
  "en": ""
 },
 {
  "id": "fn13_26:004:03",
  "speaker": "澁川",
  "jp": "この店を構えて、五年。\n……待つための場所だった。",
  "en": ""
 },
 {
  "id": "fn13_26:004:04",
  "speaker": "澁川",
  "jp": "だが、出会うための\n場所という姿も、\n持ち始めている……。",
  "en": ""
 },
 {
  "id": "fn13_26:005:00",
  "speaker": "澁川",
  "jp": "{px}。\n……お前が来てから、だな。",
  "en": ""
 },
 {
  "id": "fn13_26:006:00",
  "speaker": "澁川",
  "jp": "ああ。\n俺は……この変化を\n嬉しく感じている。",
  "en": ""
 },
 {
  "id": "fn13_26:007:00",
  "speaker": "澁川",
  "jp": "……ふッ。",
  "en": ""
 },
 {
  "id": "fn13_26:007:01",
  "speaker": "澁川",
  "jp": "そうだ。\n……悪くない、変化だ。",
  "en": ""
 },
 {
  "id": "fn13_26:008:00",
  "speaker": "澁川",
  "jp": "ああ。",
  "en": ""
 },
 {
  "id": "fn13_26:008:01",
  "speaker": "澁川",
  "jp": "俺も少しは……\nお前のそういう所を\n見習った方がいいな。",
  "en": ""
 },
 {
  "id": "fn13_26:009:00",
  "speaker": "澁川",
  "jp": "……ああ。",
  "en": ""
 },
 {
  "id": "fn13_26:010:00",
  "speaker": "澁川",
  "jp": "……自覚がないか？",
  "en": ""
 },
 {
  "id": "fn13_26:011:00",
  "speaker": "澁川",
  "jp": "やれやれ、\n自覚無し……か。",
  "en": ""
 },
 {
  "id": "fn13_26:012:00",
  "speaker": "澁川",
  "jp": "……勘違いするな。\n悪いといっている訳じゃない。",
  "en": ""
 },
 {
  "id": "fn13_26:012:01",
  "speaker": "澁川",
  "jp": "俺はむしろ……\n嬉しく思っている。",
  "en": ""
 },
 {
  "id": "fn13_26:013:00",
  "speaker": "澁川",
  "jp": "自覚がないか？",
  "en": ""
 },
 {
  "id": "fn13_26:013:01",
  "speaker": "澁川",
  "jp": "……勘違いするな。\n悪いといっている訳じゃない。",
  "en": ""
 },
 {
  "id": "fn13_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn13_26:015:00",
  "speaker": "澁川",
  "jp": "お前とお前に繋がる縁が\nその手を離れたところまでにも\n影響を与えた。",
  "en": ""
 },
 {
  "id": "fn13_26:015:01",
  "speaker": "澁川",
  "jp": "人、人……\n全く、面白い。",
  "en": ""
 },
 {
  "id": "fn13_26:015:02",
  "speaker": "澁川",
  "jp": "それを思い出させてくれた\nお前には、本当に\n感謝している。",
  "en": ""
 },
 {
  "id": "fn13_26:015:03",
  "speaker": "澁川",
  "jp": "……なあ、カナエさん？",
  "en": ""
 },
 {
  "id": "fn13_26:015:04",
  "speaker": "カナエ",
  "jp": "わふッ！！",
  "en": ""
 },
 {
  "id": "fn13_26:016:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn13_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn13_26:018:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、いつでも来い。",
  "en": ""
 },
