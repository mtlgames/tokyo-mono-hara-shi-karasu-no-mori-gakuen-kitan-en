[
 {
  "id": "fn05_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn05_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn05_30:004:00",
  "speaker": "鎧の店員",
  "jp": "昨今騒がれる、東京ＢＭ……。",
  "en": ""
 },
 {
  "id": "fn05_30:004:01",
  "speaker": "鎧の店員",
  "jp": "当店でもグッズ展開を\n始めてみるべきでないかと\n意見が出始めておるわい。",
  "en": ""
 },
 {
  "id": "fn05_30:004:02",
  "speaker": "鎧の店員",
  "jp": "だが、問題が一つ。",
  "en": ""
 },
 {
  "id": "fn05_30:004:03",
  "speaker": "鎧の店員",
  "jp": "誰も東京ＢＭの格好なんか\n詳しく知らないんだよ。",
  "en": ""
 },
 {
  "id": "fn05_30:004:04",
  "speaker": "鎧の店員",
  "jp": "どっか設定資料で三面図とか\n出してくんないかな～。",
  "en": ""
 },
 {
  "id": "fn05_30:004:05",
  "speaker": "鎧の店員",
  "jp": "……おっと、\n失礼つかまつった。",
  "en": ""
 },
 {
  "id": "fn05_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn05_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn05_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
