[
 {
  "id": "fn07_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn07_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn07_30:004:00",
  "speaker": "鎧の店員",
  "jp": "{ruby:某|それがし}、武将の甲冑が好きなのだが\n特に良いのが、兜の{ruby:立物|たてもの}である。",
  "en": ""
 },
 {
  "id": "fn07_30:004:01",
  "speaker": "鎧の店員",
  "jp": "いま身につけておるが、\n{ruby:伊達|だ　て}{ruby:政宗|まさむね}公の弦月。\nシュッとしておって実に良い。",
  "en": ""
 },
 {
  "id": "fn07_30:004:02",
  "speaker": "鎧の店員",
  "jp": "それぞれの武将が、己が功を\n広く知らしめんと{ruby:凝|こ}らした\n創意工夫……。",
  "en": ""
 },
 {
  "id": "fn07_30:004:03",
  "speaker": "鎧の店員",
  "jp": "いや～、良いよねっ！\nカタログをめくる手にも\n力がこもるってもんだよ！",
  "en": ""
 },
 {
  "id": "fn07_30:004:04",
  "speaker": "鎧の店員",
  "jp": "おっと……。",
  "en": ""
 },
 {
  "id": "fn07_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn07_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn07_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
