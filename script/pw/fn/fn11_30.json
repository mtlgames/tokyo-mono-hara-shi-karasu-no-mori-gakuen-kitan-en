[
 {
  "id": "fn11_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn11_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn11_30:004:00",
  "speaker": "鎧の店員",
  "jp": "本日は全国のサンタ殿のお力に\nなるべく、全力勤務である！",
  "en": ""
 },
 {
  "id": "fn11_30:004:01",
  "speaker": "鎧の店員",
  "jp": "時給も割増し、やる気も倍増。\n子供らに夢を運びますぞ！",
  "en": ""
 },
 {
  "id": "fn11_30:004:02",
  "speaker": "鎧の店員",
  "jp": "ん？\n{ruby:某|それがし}はサンタコスチュームなど\n邪道はせぬぞ。",
  "en": ""
 },
 {
  "id": "fn11_30:004:03",
  "speaker": "鎧の店員",
  "jp": "{ruby:如何|い　か}に動きにくくとも、\n時給のためであるッ！",
  "en": ""
 },
 {
  "id": "fn11_30:004:04",
  "speaker": "鎧の店員",
  "jp": "……あー、重ッ。",
  "en": ""
 },
 {
  "id": "fn11_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn11_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn11_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
