[
 {
  "id": "fn02_27:001:00",
  "speaker": "カルパタル",
  "jp": "{ruby:スワガト・ヘー|い　ら　っ　し　ゃ　い　ま　せ}！！\n魅惑のカレー{ruby:桃源郷|とうげんきょう}へ\nヨーコソゥ！！",
  "en": ""
 },
 {
  "id": "fn02_27:002:00",
  "speaker": "カルパタル",
  "jp": "アチャー！\nまた来たでゴザルか。\nお客サンも好きねェ。",
  "en": ""
 },
 {
  "id": "fn02_27:004:00",
  "speaker": "カルパタル",
  "jp": "さっき食べたばかりなのに、\nまた来るとは……？",
  "en": ""
 },
 {
  "id": "fn02_27:004:01",
  "speaker": "カルパタル",
  "jp": "そんなにカルさんのカレーが\n感動的だったでゴザルね！",
  "en": ""
 },
 {
  "id": "fn02_27:004:02",
  "speaker": "カルパタル",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn02_27:004:03",
  "speaker": "カルパタル",
  "jp": "おかしいでゴザルね。\nアレはまだ入れてないのに。",
  "en": ""
 },
 {
  "id": "fn02_27:004:04",
  "speaker": "カルパタル",
  "jp": "まあ来ちゃった以上は\nシカシもカカシも\nないのでゴザル。",
  "en": ""
 },
 {
  "id": "fn02_27:004:05",
  "speaker": "カルパタル",
  "jp": "友好の証に飲み物サービス！！\nささ、何にするでゴザルか？",
  "en": ""
 },
 {
  "id": "fn02_27:005:00",
  "speaker": "カルパタル",
  "jp": "おっと、\nお客サン、玄人でゴザルね。",
  "en": ""
 },
 {
  "id": "fn02_27:005:01",
  "speaker": "カルパタル",
  "jp": "良いカレーは良い水から。\n料理の基礎、それは水！！",
  "en": ""
 },
 {
  "id": "fn02_27:005:02",
  "speaker": "カルパタル",
  "jp": "しかーし、このカルさんに\n死角はないでゴザルよ。\n堪能するがヨロシカロウ！",
  "en": ""
 },
 {
  "id": "fn02_27:006:00",
  "speaker": "カルパタル",
  "jp": "カレー屋の定番、ドコで\n頼んでも大体ハズレ無しの\n定番ドリンクでゴザルな……。",
  "en": ""
 },
 {
  "id": "fn02_27:006:01",
  "speaker": "カルパタル",
  "jp": "まあいいでゴザル。\nとっとと召し上がれで\nゴザルよ～。",
  "en": ""
 },
 {
  "id": "fn02_27:007:00",
  "speaker": "カルパタル",
  "jp": "その{ruby:注文|オーダー}……\n久々に聞くでゴザル……。",
  "en": ""
 },
 {
  "id": "fn02_27:007:01",
  "speaker": "カルパタル",
  "jp": "そうでゴザルな……。\nカレーの無限の可能性は\n全てを越える―――！！",
  "en": ""
 },
 {
  "id": "fn02_27:007:02",
  "speaker": "カルパタル",
  "jp": "さあ、思うままに\n飲み干すがいいでゴザル！！",
  "en": ""
 },
 {
  "id": "fn02_27:008:00",
  "speaker": "カルパタル",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn02_27:008:01",
  "speaker": "カルパタル",
  "jp": "アッハッハ！！おおお客サン、\nへへ変なコト言うでゴザルね。",
  "en": ""
 },
 {
  "id": "fn02_27:008:02",
  "speaker": "カルパタル",
  "jp": "アレなんてアレは\nココにはナイでゴザルよ。",
  "en": ""
 },
 {
  "id": "fn02_27:008:03",
  "speaker": "カルパタル",
  "jp": "つべこべ言わずに\n大人しく水でも\n召し上がっとけでゴザルよ。",
  "en": ""
 },
 {
  "id": "fn02_27:010:00",
  "speaker": "カルパタル",
  "jp": "さてさて、まだ何か\nご用はあるでゴザルかー？",
  "en": ""
 },
 {
  "id": "fn02_27:011:00",
  "speaker": "カルパタル",
  "jp": "ささ、買い物するね！\nいつでも品揃えは\nバチリコバジルよー。",
  "en": ""
 },
 {
  "id": "fn02_27:012:00",
  "speaker": "カルパタル",
  "jp": "ありがとゴンしたー！！",
  "en": ""
 },
