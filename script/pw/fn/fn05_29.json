[
 {
  "id": "fn05_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well hello, dearie, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fn05_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to buy somethin', did ya?"
 },
 {
  "id": "fn05_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "{pm}ちゃん。あんね。\n若いんやし仕方ないんかも\nしれへんけど……。",
  "en": "{pm}-chan. Listen here. You're young, so maybe it\ncan't be helped, but..."
 },
 {
  "id": "fn05_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "のぞきは、あかんで。",
  "en": "Peepin' is a no-no, ya hear."
 },
 {
  "id": "fn05_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "ど～しても我慢出来んかったら\nおばちゃんが協力するで！\nおばちゃん本気やで！",
  "en": "If ya just can't hold it in no matter what, this old\nlady'll lend a hand! I mean it, I really do!"
 },
 {
  "id": "fn05_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "ほら、あめちゃん食べて\nおばちゃんとお約束や！",
  "en": "Here, have a candy and make this old lady a\npromise!"
 },
 {
  "id": "fn05_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fn05_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So then, what'll it be?"
 },
 {
  "id": "fn05_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thank you, dearie. Come again, now~"
 },
