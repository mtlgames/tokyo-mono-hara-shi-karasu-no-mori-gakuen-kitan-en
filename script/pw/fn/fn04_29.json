[
 {
  "id": "fn04_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there, welcome! Lookin' for somethin'?"
 },
 {
  "id": "fn04_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "My, my, my. Forget to buy somethin'?"
 },
 {
  "id": "fn04_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "あの転入生、またすぐ\nどっかに行くんやそうね。",
  "en": "I hear that new transfer student's movin' on\nsomewhere else again real soon."
 },
 {
