[
 {
  "id": "fn01_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn01_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn01_30:004:00",
  "speaker": "鎧の店員",
  "jp": "当店では昔懐かしの玩具から\n最新のエアガンまで\n幅広く揃えておりまする。",
  "en": ""
 },
 {
  "id": "fn01_30:004:01",
  "speaker": "鎧の店員",
  "jp": "{ruby:某|それがし}、此方に控えておりますゆえ\n遠慮無くご覧下され。",
  "en": ""
 },
 {
  "id": "fn01_30:004:02",
  "speaker": "鎧の店員",
  "jp": "あー……。\n重っ。",
  "en": ""
 },
 {
  "id": "fn01_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn01_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn01_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
