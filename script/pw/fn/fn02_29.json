[
 {
  "id": "fn02_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well, hello there, hon! What can I get ya?"
 },
 {
  "id": "fn02_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to pick somethin' up?"
 },
 {
  "id": "fn02_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "まだ残ってるん？\nあかんで～、怖い生徒会が\n追い出しにかかってるからね。",
  "en": "You're still here? Oh, that won't do~ The scary\nstudent council's out chasin' everybody home."
 },
 {
  "id": "fn02_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "いや、ええよ！\nおばちゃんは、何も見てへん。",
  "en": "Oh, no, it's fine! Auntie didn't see a thing."
 },
 {
  "id": "fn02_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "……そう言うてあげるし、\n{ruby:早|はよ}う帰りや～。",
  "en": "...That's what I'll tell 'em, so you hurry on home\nnow~"
 },
 {
  "id": "fn02_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn02_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn02_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "Thanks a bunch, hon. Come again now~"
 },
