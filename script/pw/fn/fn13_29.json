[
 {
  "id": "fn13_29:001:00",
  "speaker": "購買のおばちゃん",
  "jp": "あ～ら、いらっしゃい。\n何か欲しいん？",
  "en": "Well hello there, welcome!\nSomethin' you're after, hon?"
 },
 {
  "id": "fn13_29:002:00",
  "speaker": "購買のおばちゃん",
  "jp": "あらあら、まあまあ。\n買い忘れでもあったん？",
  "en": "Oh my, oh my. Forget to buy somethin', did ya?"
 },
 {
  "id": "fn13_29:004:00",
  "speaker": "購買のおばちゃん",
  "jp": "ん～……。\n参ったわあ……。",
  "en": "Hmm... What a pickle..."
 },
 {
  "id": "fn13_29:004:01",
  "speaker": "購買のおばちゃん",
  "jp": "おばちゃん、冬休み中は\nハワイ行くねん、ハワイ。",
  "en": "Over winter break, auntie's goin' to Hawaii. Hawaii!"
 },
 {
  "id": "fn13_29:004:02",
  "speaker": "購買のおばちゃん",
  "jp": "せやから英語の一つも出来んと\nバカにされる思うて、\n教科書借りたんやけど……。",
  "en": "So I figured folks'd laugh at me if I couldn't speak\na lick of English, and I borrowed a textbook, but..."
 },
 {
  "id": "fn13_29:004:03",
  "speaker": "購買のおばちゃん",
  "jp": "あんたら、えらい難しい事\nやってるんねえ……。",
  "en": "You kids sure are studyin'\nsome awful hard stuff, huh..."
 },
 {
  "id": "fn13_29:005:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn13_29:006:00",
  "speaker": "購買のおばちゃん",
  "jp": "ほな、どうする？",
  "en": "So, what'll it be?"
 },
 {
  "id": "fn13_29:007:00",
  "speaker": "購買のおばちゃん",
  "jp": "はい、ありがとね。\nまたおいでや～。",
  "en": "There ya go, thank you kindly. Come on back now!"
 },
