[
 {
  "id": "fn06_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn06_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn06_30:004:00",
  "speaker": "鎧の店員",
  "jp": "こうしてバイトを始めて\n{ruby:幾星霜|いくせいそう}か……。",
  "en": ""
 },
 {
  "id": "fn06_30:004:01",
  "speaker": "鎧の店員",
  "jp": "ついに念願の政宗公の具足を\n購入し、着る機会まで得た。",
  "en": ""
 },
 {
  "id": "fn06_30:004:02",
  "speaker": "鎧の店員",
  "jp": "だが本多の鹿角{ruby:大脇立|おおわきだて}には\n矢張り、シビれる憧れるッ！",
  "en": ""
 },
 {
  "id": "fn06_30:004:03",
  "speaker": "鎧の店員",
  "jp": "はァ……。\nただカタログを眺めては\n指をくわえる日々である。",
  "en": ""
 },
 {
  "id": "fn06_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn06_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn06_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
