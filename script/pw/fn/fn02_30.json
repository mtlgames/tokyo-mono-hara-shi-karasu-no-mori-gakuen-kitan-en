[
 {
  "id": "fn02_30:001:00",
  "speaker": "鎧の店員",
  "jp": "ここは、玩具と夢の{ruby:戦場|いくさば}、\nイエス！サブリミナルである。\nごゆるりと堪能あれ。",
  "en": ""
 },
 {
  "id": "fn02_30:002:00",
  "speaker": "鎧の店員",
  "jp": "何度もかたじけない。\nどうか、ごゆるりと。",
  "en": ""
 },
 {
  "id": "fn02_30:004:00",
  "speaker": "鎧の店員",
  "jp": "おや、{ruby:貴君|きくん}の制服は、\n袋殿と同じものであるな。",
  "en": ""
 },
 {
  "id": "fn02_30:004:01",
  "speaker": "鎧の店員",
  "jp": "彼の人は我が主、店長も\n一目置くほどの人物……。\nご存知あるか？",
  "en": ""
 },
 {
  "id": "fn02_30:004:02",
  "speaker": "鎧の店員",
  "jp": "袋殿の宣伝力は凄まじくてな、\n是非に当店の袋をかぶり続けて\nいただきたい所存。",
  "en": ""
 },
 {
  "id": "fn02_30:004:03",
  "speaker": "鎧の店員",
  "jp": "{ruby:某|それがし}の格好も、そもそもは\n彼への挑戦とかぬかす店長の\nアホな……。",
  "en": ""
 },
 {
  "id": "fn02_30:004:04",
  "speaker": "鎧の店員",
  "jp": "ごふん。",
  "en": ""
 },
 {
  "id": "fn02_30:004:05",
  "speaker": "鎧の店員",
  "jp": "{ruby:某|それがし}、それなら自分でやれよとか\n一つも思ってはござらんぞ。",
  "en": ""
 },
 {
  "id": "fn02_30:005:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn02_30:006:00",
  "speaker": "鎧の店員",
  "jp": "他に御用がありましたら、\nなんなりとお申し付けあれ。",
  "en": ""
 },
 {
  "id": "fn02_30:007:00",
  "speaker": "鎧の店員",
  "jp": "またのお越しを\nお待ちしておりますぞ。",
  "en": ""
 },
