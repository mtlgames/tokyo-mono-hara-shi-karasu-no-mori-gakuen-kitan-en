[
 {
  "id": "fn05_26:001:00",
  "speaker": "澁川",
  "jp": "……よく、来たな。\n仕事、か？",
  "en": ""
 },
 {
  "id": "fn05_26:002:00",
  "speaker": "澁川",
  "jp": "お前か。\n……好きにしていけ。",
  "en": ""
 },
 {
  "id": "fn05_26:004:00",
  "speaker": "澁川",
  "jp": "人と人の触れ合いには、\n色々な形があるな。",
  "en": ""
 },
 {
  "id": "fn05_26:004:01",
  "speaker": "澁川",
  "jp": "表面と、\n奥深いところ……。",
  "en": ""
 },
 {
  "id": "fn05_26:005:00",
  "speaker": "澁川",
  "jp": "お前は、他人の顔の裏にある\n真の思考、感情までも\n知りたいと願うか？",
  "en": ""
 },
 {
  "id": "fn05_26:006:00",
  "speaker": "澁川",
  "jp": "……そうやってお前は、皆と\n関わっているんだな。",
  "en": ""
 },
 {
  "id": "fn05_26:006:01",
  "speaker": "澁川",
  "jp": "だから、自然と人が\n集まるんだろう……。",
  "en": ""
 },
 {
  "id": "fn05_26:006:02",
  "speaker": "澁川",
  "jp": "少しばかり、\n罪作りではあるな。",
  "en": ""
 },
 {
  "id": "fn05_26:007:00",
  "speaker": "澁川",
  "jp": "あまり脳天気にずかずかと\n入り込んでばかりいると\nいつか、しっぺ返しをくうぞ？",
  "en": ""
 },
 {
  "id": "fn05_26:008:00",
  "speaker": "澁川",
  "jp": "わかった、わかった。",
  "en": ""
 },
 {
  "id": "fn05_26:008:01",
  "speaker": "澁川",
  "jp": "そうまでされたら、\n皆も応ぜずには\nいられないだろう……。",
  "en": ""
 },
 {
  "id": "fn05_26:009:00",
  "speaker": "澁川",
  "jp": "そうか……。",
  "en": ""
 },
 {
  "id": "fn05_26:010:00",
  "speaker": "澁川",
  "jp": "なるほど。裏を返せば\nお前も、そうして欲しくない\nと……いう事になるか。",
  "en": ""
 },
 {
  "id": "fn05_26:011:00",
  "speaker": "澁川",
  "jp": "なるほど。裏を返せば\nお前も、そうして欲しくない\nと……いう事になるか。",
  "en": ""
 },
 {
  "id": "fn05_26:012:00",
  "speaker": "澁川",
  "jp": "他人の痛みを察して\n触れるのを{ruby:躊躇|ためら}うか。",
  "en": ""
 },
 {
  "id": "fn05_26:012:01",
  "speaker": "澁川",
  "jp": "お前は、優しいな。",
  "en": ""
 },
 {
  "id": "fn05_26:013:00",
  "speaker": "澁川",
  "jp": "……わからないなら、いい。",
  "en": ""
 },
 {
  "id": "fn05_26:014:00",
  "speaker": "澁川",
  "jp": "…………。",
  "en": ""
 },
 {
  "id": "fn05_26:015:00",
  "speaker": "澁川",
  "jp": "俺は、暑苦しい付き合いは、\n嫌いじゃない。\nだが……。",
  "en": ""
 },
 {
  "id": "fn05_26:015:01",
  "speaker": "澁川",
  "jp": "懐に入れすぎると、\n思わぬ痛みを\n負う事にもなる。",
  "en": ""
 },
 {
  "id": "fn05_26:015:02",
  "speaker": "澁川",
  "jp": "俺はもうすっかり、臆病に\nなったのかもしれんな。",
  "en": ""
 },
 {
  "id": "fn05_26:016:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn05_26:017:00",
  "speaker": "澁川",
  "jp": "何か……他に、あるか？",
  "en": ""
 },
 {
  "id": "fn05_26:018:00",
  "speaker": "澁川",
  "jp": "……そうか。\nまた、来るといい。",
  "en": ""
 },
