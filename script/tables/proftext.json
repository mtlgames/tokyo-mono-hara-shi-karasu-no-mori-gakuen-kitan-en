 {
  "id": "proftext:0013:00",
  "jp": "問２　図書館について",
  "refs": 1,
  "en": "Q2. About the Library"
 },
 {
  "id": "proftext:0014:00",
  "jp": "あなたは普段、どの程度図書館を利用していますか？\n下記の中から当てはまる物を1つ選んでください。　",
  "refs": 1,
  "en": "How often do you usually use the library? Choose\nthe one that applies from the list below."
 },
 {
  "id": "proftext:0015:00",
  "jp": "よく利用する",
  "refs": 1,
  "en": "Often"
 },
 {
  "id": "proftext:0016:00",
  "jp": "たまに利用する",
  "refs": 1,
  "en": "Sometimes"
 },
 {
  "id": "proftext:0017:00",
  "jp": "あまり利用しない",
  "refs": 1,
  "en": "Rarely"
 },
 {
  "id": "proftext:0018:00",
  "jp": "ほとんど利用しない",
  "refs": 1,
  "en": "Almost never"
 },
 {
  "id": "proftext:0019:00",
  "jp": "問３　アルバイトについて",
  "refs": 1,
  "en": "Q3. About Part-Time Jobs"
 },
 {
  "id": "proftext:0020:00",
  "jp": "あなたはアルバイトをしたことがありますか？\nあるいはしてみたいですか？\nまた、それは何のためですか？\n下記の中から当てはまる物を1つ選んでください。",
  "refs": 1,
  "en": "Have you ever had a part-time job, or would you\nlike one? And if so, why? Choose the one that\napplies below."
 },
 {
  "id": "proftext:0021:00",
  "jp": "お金のため",
  "refs": 1,
  "en": "For money"
 },
 {
  "id": "proftext:0022:00",
  "jp": "視野を広げるため",
  "refs": 1,
  "en": "To broaden my horizons"
 },
 {
  "id": "proftext:0023:00",
  "jp": "その他の理由",
  "refs": 1,
  "en": "Other reasons"
 },
 {
  "id": "proftext:0024:00",
  "jp": "アルバイトはしない",
  "refs": 1,
  "en": "I don't work part-time"
 },
 {
  "id": "proftext:0025:00",
  "jp": "回答が終わったら、用紙を裏返してください。",
  "refs": 1,
  "en": "When you have finished answering, turn the sheet\nover."
 },
