[
 {
  "id": "proftext:0000:00",
  "jp": "日常と意識に関するアンケート",
  "refs": 1,
  "en": "Survey on Daily Life and Awareness"
 },
 {
  "id": "proftext:0001:00",
  "jp": "質問をよく読み、当てはまるものを答えてください。",
  "refs": 1,
  "en": "Read each question carefully and answer with\nwhat applies to you."
 },
 {
  "id": "proftext:0002:00",
  "jp": "フリガナ",
  "refs": 1,
  "en": "Name Reading"
 },
 {
