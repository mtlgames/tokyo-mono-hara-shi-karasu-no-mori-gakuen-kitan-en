  "jp": "氏名",
  "refs": 1,
  "en": "Name"
 },
 {
  "id": "proftext:0004:00",
  "jp": "問１　勉強について",
  "refs": 1,
  "en": "Q1. About Your Studies"
 },
 {
  "id": "proftext:0005:00",
  "jp": "あなたが興味を持っている科目はなんですか？\n下記の中から1つ選んでください。",
  "refs": 1,
  "en": "Which subject are you interested in? Choose one\nfrom the list below."
 },
 {
  "id": "proftext:0006:00",
  "jp": "国語",
  "refs": 1,
  "en": "Japanese"
 },
 {
  "id": "proftext:0007:00",
  "jp": "数学",
  "refs": 1,
  "en": "Math"
 },
 {
