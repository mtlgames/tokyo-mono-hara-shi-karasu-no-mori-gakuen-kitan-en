[
 {
  "id": "clctbgm:0000:00",
  "jp": "祭囃子・日ヘノ問掛ノ調",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0000:08",
  "jp": "まつりばやし・ひへのといかけのしらべ",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0000:0c",
  "jp": "人と人との戦いを演出する激し\nい調べ。『誘の訴』の切ない旋\n律が、戦いの熱さと辛さを表現\nしている。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0001:00",
  "jp": "鹿の音慰む懐抱",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0001:08",
  "jp": "かのねなぐさむものおもい",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0001:0c",
  "jp": "悲哀に満ちた場面を演出する切\nない調べ。澄んだピアノの音色\nが、少しずつ溢れ出す感情を表\n現している。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0002:00",
  "jp": "春告げ響む主の御名",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0002:08",
  "jp": "はるつげとよむぬしのみな",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0002:0c",
  "jp": "身の内から沸き上がり、やがて\nはその身までも焼き尽くそうと\nするかのような情熱の調べ。音\n色は和だがフレーズは大陸的。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0003:00",
  "jp": "玄鳥追い追い背なの影",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0003:08",
  "jp": "つばめおいおいせなのかげ",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0003:0c",
  "jp": "真相への追求を表現した疾走感\n溢れる調べ。息をつかせぬ緊張\n感を演出しており、登場人物の\n焦燥感を際だたせる。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0004:00",
  "jp": "杜宇の初聲朧に消ゆ",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0004:08",
  "jp": "とうのはつこえおぼろにきゆ",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0004:0c",
  "jp": "人の手の届かぬ場所にある幽玄\nな事象を語る調べ。神がかりの\n美しさを表現し、邂逅の驚愕を\nも内包している。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0005:00",
  "jp": "十六の舞い天に到りてとも咲い",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0005:08",
  "jp": "ししのまいあめにいたりてともわらい",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0005:0c",
  "jp": "緊張した日常において心を和ま\nせずにいられない喜劇の調べ。\n弛緩の一瞬を、三味線の旋律と\n掛け声が彩っている。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0006:00",
  "jp": "Come on!HERO!",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0006:08",
  "jp": "カモン！　ヒーロー！",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0006:0c",
  "jp": "英雄を讃え、その活躍を余す所\n無く語り継ぐ口上の如き調べ。\nギターとトランペットの音色が\n熱い血の滾りを彷彿させる。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0007:00",
  "jp": "簒奪者の宴",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0007:08",
  "jp": "さんだつしゃ　の　うたげ",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0007:0c",
  "jp": "泣く子もひれ伏す、暴風の如き\n大盗賊を頭に持つ鬼印盗賊団の\n調べ。悪徳の美学と共にどこか\n憎めないやんちゃさが伺える。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0008:00",
  "jp": "キリフダ",
  "refs": 2,
  "en": ""
 },
 {
  "id": "clctbgm:0008:0c",
  "jp": "ヒロイックなフレーズでありな\nがら、少女の弱さと強さの両面\nをも表現するこの作品のメイン\nテーマ。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0009:00",
  "jp": "誘の訴",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0009:08",
  "jp": "いざないのうた",
  "refs": 1,
  "en": ""
 },
 {
  "id": "clctbgm:0009:0c",
  "jp": "死と再生を訴う詞と、日に照ら\nされ黄金に輝いて流れる水をイ\nメージしたメロディが重なるこ\nの作品のエンディングテーマ。",
  "refs": 1,
  "en": ""
 }
]
