  "jp": "そちらからでも確認ができます。",
  "refs": 1,
  "en": "so you can check it there too."
 },
 {
  "id": "questwordcomment:0026:00",
  "jp": "ただし報告はできません。",
  "refs": 1,
  "en": "You can't report from there, though."
 },
 {
  "id": "questwordcomment:0029:00",
  "jp": "【依頼のヒント】",
  "refs": 1,
