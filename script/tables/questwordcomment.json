 },
 {
  "id": "questwordcomment:0062:00",
  "jp": "報酬が手に入ります。",
  "refs": 1,
  "en": "to receive your reward."
 },
 {
  "id": "questwordcomment:0065:00",
  "jp": "＜依頼する場合＞",
  "refs": 1,
  "en": "<Giving Quests>"
 },
 {
  "id": "questwordcomment:0066:00",
  "jp": "あなたの依頼人としての情報や",
  "refs": 1,
  "en": "Enter your info as a client"
 },
 {
  "id": "questwordcomment:0067:00",
  "jp": "依頼内容を入力して、",
  "refs": 1,
  "en": "and the quest details"
 },
 {
  "id": "questwordcomment:0068:00",
  "jp": "依頼カードを作ります。",
  "refs": 1,
  "en": "to make a quest card."
 },
 {
  "id": "questwordcomment:0069:00",
  "jp": "そしてお互いに情報を交換して、",
  "refs": 1,
  "en": "Then exchange info with each other"
 },
 {
  "id": "questwordcomment:0070:00",
  "jp": "相手に依頼を渡します。",
  "refs": 1,
  "en": "to hand over your quest."
 },
 {
  "id": "questwordcomment:0072:00",
  "jp": "あとは相手が依頼を終えたら、",
  "refs": 1,
  "en": "Once they finish the quest,"
 },
 {
  "id": "questwordcomment:0073:00",
  "jp": "再び情報を交換して、",
  "refs": 1,
  "en": "exchange info again"
 },
 {
  "id": "questwordcomment:0074:00",
  "jp": "依頼料を支払えば、",
  "refs": 1,
  "en": "and pay the fee"
 },
 {
  "id": "questwordcomment:0075:00",
  "jp": "依頼物を手に入れることができます。",
  "refs": 1,
  "en": "to get what you asked for."
 },
 {
  "id": "questwordcomment:0078:00",
  "jp": "【ダウンロード】",
  "refs": 1,
  "en": "[Download]"
 },
 {
  "id": "questwordcomment:0079:00",
  "jp": "ここではネットワーク上から、",
  "refs": 1,
  "en": "Here you can get quest cards"
 },
 {
  "id": "questwordcomment:0080:00",
  "jp": "依頼カードを手に入れることができます。",
  "refs": 1,
  "en": "from the network."
 },
 {
  "id": "questwordcomment:0082:00",
  "jp": "依頼を選んでダウンロードしたら、",
  "refs": 1,
  "en": "Choose and download a quest, then"
 },
 {
