  "en": "\"Defeat enemies (Slaying of...)\""
 },
 {
  "id": "questwordcomment:0036:00",
  "jp": "「行動する（～の儀）」",
  "refs": 1,
  "en": "\"Take actions (Rite of...)\""
 },
 {
  "id": "questwordcomment:0037:00",
  "jp": "「カミフダを置く（～の陣）」",
  "refs": 1,
  "en": "\"Place cards (Array of...)\""
 },
