[
 {
  "id": "questwordcomment:0000:00",
  "jp": "【依頼を探す】",
  "refs": 1,
  "en": "[Find Quests]"
 },
 {
  "id": "questwordcomment:0001:00",
  "jp": "依頼人から集められた、",
  "refs": 1,
  "en": "You'll be handed cards gathered from"
 },
 {
  "id": "questwordcomment:0002:00",
  "jp": "依頼が書かれたカードを渡されます。",
  "refs": 1,
  "en": "clients, each with a quest on it."
 },
 {
  "id": "questwordcomment:0003:00",
  "jp": "カードを見るには情報料を支払います。",
  "refs": 1,
  "en": "To see a card, you pay an info fee."
 },
 {
  "id": "questwordcomment:0004:00",
  "jp": "（特別に無料の場合もあります）",
  "refs": 1,
  "en": "(Sometimes it's free, as a special.)"
 },
 {
