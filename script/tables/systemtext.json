 },
 {
  "id": "systemtext:0075:00",
  "jp": "あなたは普段、どの程度図書館を利用していますか？\n下記の中から当てはまる物を1つ選んでください。　",
  "refs": 1,
  "en": "How often do you usually use the library? Choose\nthe one answer below that applies."
 },
