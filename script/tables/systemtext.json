 {
  "id": "systemtext:0080:00",
  "jp": "問３　アルバイトについて",
  "refs": 1,
  "en": "Q3: Part-Time Jobs"
 },
 {
  "id": "systemtext:0081:00",
  "jp": "あなたはアルバイトをしたことがありますか？\nあるいはしてみたいですか？\nまた、それは何のためですか？\n下記の中から当てはまる物を1つ選んでください。",
  "refs": 1,
  "en": "Have you ever had a part-time job, or would you\nlike one? And if so, why? Choose the one answer\nbelow that applies."
 },
 {
  "id": "systemtext:0082:00",
  "jp": "お金のため",
  "refs": 1,
  "en": "For the money"
 },
 {
  "id": "systemtext:0083:00",
  "jp": "視野を広げるため",
  "refs": 1,
  "en": "To broaden my horizons"
 },
 {
  "id": "systemtext:0084:00",
  "jp": "その他の理由",
  "refs": 1,
  "en": "Some other reason"
 },
 {
  "id": "systemtext:0085:00",
  "jp": "アルバイトはしない",
  "refs": 1,
  "en": "I don't work part-time"
 },
 {
  "id": "systemtext:0086:00",
  "jp": "回答が終わったら、用紙を裏返してください。",
  "refs": 1,
  "en": "When you have finished, turn the sheet over."
 },
