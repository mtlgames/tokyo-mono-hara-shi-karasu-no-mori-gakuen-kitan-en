 },
 {
  "id": "systemtext:0462:00",
  "jp": "札の情報を封じる鬼札の焔。\n敵にダメージを与える。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0463:00",
  "jp": "雁の風の力をまとった正拳突き。\n敵にダメージを与える。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0464:00",
  "jp": "水のオーラをまとった拳による攻撃\n一定確率で麻痺状態にする。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0465:00",
  "jp": "札の力をこめて歌い傷を癒す。\nＨＰが回復する。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0466:00",
  "jp": "札の加護をもつ刀による居合攻撃。\n仲間が秋の札憑きならば攻撃力増加",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0467:00",
  "jp": "札の加護をもつ文房具の投擲攻撃。\n必ず弱点に命中する。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0468:00",
  "jp": "札を投げて表が出たら攻撃するまで\n範囲内の敵に数ターン気づかれない",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0469:00",
  "jp": "二本のトンファーを使った攻撃。\n衝撃波が一直線に伸びる。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0470:00",
  "jp": "範囲内の敵へ攻撃し、当たった敵の\n弱点が数ターン見えるようになる。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0471:00",
  "jp": "敵の体力を奪う鱗粉を撒く攻撃。\n一定確率で封呪状態にする。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0472:00",
  "jp": "退魔札を無数の針に変えて攻撃。\n一定確率で麻痺状態にする。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0473:00",
  "jp": "魅惑のオーラを放出し、一定確率で\n敵ＨＰの５％を吸収する。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0474:00",
  "jp": "桜吹雪の衝撃波を起こす攻撃。\n敵を２マス吹き飛ばす。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0475:00",
  "jp": "ターン終了まで攻撃力・防御力強化\nＨＰ減少量に比例して強化率上昇",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0476:00",
  "jp": "敵の攻撃を受ける際、１度だけ一定\n確率で回避してカウンター攻撃。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0477:00",
  "jp": "剣舞のような流麗な攻撃。\n一定確率で敵を睡眠状態にする。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0478:00",
  "jp": "蹴りによる範囲攻撃。\n敵にダメージを与える。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0479:00",
  "jp": "拳による単体攻撃。\n敵にダメージを与える。",
  "refs": 1,
  "en": ""
 },
