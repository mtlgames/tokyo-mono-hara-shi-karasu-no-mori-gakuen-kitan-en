  "refs": 1,
  "en": "--------"
 },
 {
  "id": "systemtext:0168:00",
  "jp": "が",
  "refs": 1,
  "en": ":"
 },
 {
  "id": "systemtext:0169:00",
  "jp": "完成しました。",
  "refs": 1,
  "en": "Created!"
 },
 {
  "id": "systemtext:0170:00",
  "jp": "に",
  "refs": 1,
  "en": "->"
 },
 {
  "id": "systemtext:0171:00",
  "jp": "変化しました。",
  "refs": 1,
  "en": "Transformed!"
 },
 {
  "id": "systemtext:0172:00",
  "jp": "残っているアイテムを破棄します。\nよろしいですか？",
  "refs": 1,
  "en": "The remaining items will be discarded. Is that\nokay?"
 },
 {
  "id": "systemtext:0173:00",
  "jp": "このアイテムを渡しますか？",
  "refs": 1,
  "en": "Hand over this item?"
 },
 {
  "id": "systemtext:0174:00",
  "jp": "携行のスロットが一杯です。\n整理してアイテムを収納しますか？",
  "refs": 1,
  "en": "Your pack is full. Sort it out and store the\nitem?"
 },
 {
  "id": "systemtext:0175:00",
  "jp": "強化中の札をはがしますか？",
  "refs": 1,
  "en": "Remove the enhancing card?"
 },
 {
  "id": "systemtext:0176:00",
  "jp": "すでに強化されています。\n別の札に入れ替えますか？",
  "refs": 1,
  "en": "This is already enhanced. Swap in a different\ncard?"
 },
 {
  "id": "systemtext:0178:00",
  "jp": "これでよろしいですか？",
  "refs": 1,
  "en": "Is this okay?"
 },
 {
  "id": "systemtext:0179:00",
  "jp": "これ以上持てません。",
  "refs": 1,
  "en": "You can't carry any more."
 },
 {
  "id": "systemtext:0180:00",
  "jp": "お金が足りません。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0181:00",
  "jp": "この組み合わせで調合します。\nよろしいですか？",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0182:00",
  "jp": "札強化は探索準備中か\n洞探索中でのみ行えます。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0183:00",
  "jp": "現在この札は配置中です。\n札配置画面で回収して下さい。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0184:00",
  "jp": "同じ武器を複数装備できません。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0185:00",
  "jp": "同じ武器を複数装備できません。\n変化前の武器と同じ武器を装備しています。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0186:00",
  "jp": "同じ武器を複数装備できません。\n選択中の武器の強化後と同じ武器を装備しています。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0187:00",
  "jp": "名前がデフォルトネームから変更されています。\nふりがなを空欄のまま決定はできません。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0188:00",
  "jp": "回収していないアイテムの中に\n破棄できないものが含まれています。\nアイテムを回収して下さい。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0189:00",
  "jp": "このアイテムは譲渡できません。",
  "refs": 1,
  "en": ""
 },
 {
  "id": "systemtext:0190:00",
  "jp": "この空きスロットは携行品に使われています。\n装備する場合、「%s」を\n自室に戻します。よろしいですか？",
  "refs": 1,
  "en": ""
 },
